<Window x:Class="EnigmaWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EnigmaWin.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="EnigmaWin"
        Width="1100" Height="700">

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row="0">

            <MenuItem Header="Radix" Command="{Binding SelectRadixCommand}">
                <MenuItem Header="New Chart"    Command="{Binding NewChartCommand}"/>
                <MenuItem Header="Overview"     Command="{Binding ShowOverviewCommand}"/>
                <MenuItem Header="Positions"    Command="{Binding ShowPositionsCommand}"/>
                <MenuItem Header="Search"       Command="{Binding SearchRadixCommand}"/>
                <MenuItem Header="Analysis"     Command="{Binding ShowAnalysisCommand}"/>
                <MenuItem Header="Declinations" Command="{Binding ShowDeclinationsCommand}"/>
                <Separator/>
                <MenuItem Header="Back View 1" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="Back View 2" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="Configuration" Command="{Binding SelectConfigurationCommand}">
                <MenuItem Header="Overview"           Command="{Binding SelectConfigurationCommand}"/>
                <MenuItem Header="New Configuration"  Command="{Binding NewConfigurationCommand}"/>
                <MenuItem Header="Edit Configuration" Command="{Binding EditConfigurationCommand}"/>
                <Separator/>
                <MenuItem Header="Back View 1" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="Back View 2" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="Research" Command="{Binding SelectResearchCommand}">
                <MenuItem Header="Projects" Command="{Binding SelectResearchProjectsCommand}"/>
            </MenuItem>

            <MenuItem Header="Periods" Command="{Binding SelectCyclesCommand}">
                <MenuItem Header="Astronomical Cycles" Command="{Binding SelectCyclesAstronomicalCommand}"/>
                <MenuItem Header="Waves"               Command="{Binding SelectCyclesWavesCommand}"/>
                <MenuItem Header="Ephemeris"           Command="{Binding SelectEphemerisCommand}"/>
                <MenuItem Header="Eclipses"            Command="{Binding SelectEclipsesCommand}"/>
            </MenuItem>

            <MenuItem Header="Calculators" Command="{Binding SelectCalculatorsCommand}">
                <MenuItem Header="Julian Day"    Command="{Binding SelectCalculatorsJulianDayCommand}"/>
                <MenuItem Header="Obliquity"     Command="{Binding SelectCalculatorsObliquityCommand}"/>
                <MenuItem Header="Sidereal Time" IsEnabled="False"/>
            </MenuItem>

            <MenuItem Header="Progressive" Command="{Binding SelectProgressiveCommand}">
                <MenuItem Header="Events"    Command="{Binding SelectProgressiveEventsCommand}"/>
                <MenuItem Header="Transit"   Command="{Binding SelectProgressiveTransitCommand}"/>
                <MenuItem Header="Secondary" Command="{Binding SelectProgressiveSecondaryCommand}"/>
                <MenuItem Header="Symbolic"           Command="{Binding SelectProgressiveSymbolicCommand}"/>
                <MenuItem Header="Log Time Scale"    Command="{Binding SelectProgressiveLogTimeScaleCommand}"/>
                <MenuItem Header="Age Point"         Command="{Binding SelectProgressiveAgePointCommand}"/>
                <MenuItem Header="Solar Return"      Command="{Binding SelectProgressiveSolarCommand}"/>
                <MenuItem Header="Primary Directions" Command="{Binding SelectProgressivePrimDirCommand}"/>
                <MenuItem Header="Pre-Natal Events"   Command="{Binding SelectProgressivePreNatalCommand}"/>
                <Separator/>
                <MenuItem Header="Back View 1" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="Back View 2" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Click="OnAboutClicked"/>
            </MenuItem>

        </Menu>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation sidebar -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="EnigmaWin" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Navigation" Opacity="0.7"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Workspace" FontSize="12" Opacity="0.75" Margin="0,0,0,4"/>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectRadixCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Radix" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectConfigurationCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectResearchCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Research" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectCyclesCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Periods" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectCalculatorsCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Calculators" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectProgressiveCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Progressive" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Actions" FontSize="12" Opacity="0.75" Margin="0,0,0,6"/>
                            <Button Content="Back View 1"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackMainCommand}"
                                    IsEnabled="{Binding CanGoBackMain}"
                                    Margin="0,0,0,4"/>
                            <Button Content="Back View 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackDetailCommand}"
                                    IsEnabled="{Binding CanGoBackDetail}"
                                    Margin="0,0,0,4"/>

                            <StackPanel Visibility="{Binding ShowRadixButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="New Chart"   Command="{Binding NewChartCommand}"       HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="Overview"    Command="{Binding ShowOverviewCommand}"   HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="Positions"   Command="{Binding ShowPositionsCommand}"  HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="Search"      Command="{Binding SearchRadixCommand}"    HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="Analysis"    Command="{Binding ShowAnalysisCommand}"   HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowConfigurationButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="New Configuration"  HorizontalAlignment="Stretch" Command="{Binding NewConfigurationCommand}"  Margin="0,0,0,4"/>
                                <Button Content="Edit Configuration" HorizontalAlignment="Stretch" Command="{Binding EditConfigurationCommand}" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowResearchButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Projects" HorizontalAlignment="Stretch" Command="{Binding SelectResearchProjectsCommand}" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowCyclesButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Astronomical Cycles" HorizontalAlignment="Stretch" Command="{Binding SelectCyclesAstronomicalCommand}" Margin="0,0,0,4"/>
                                <Button Content="Waves"               HorizontalAlignment="Stretch" Command="{Binding SelectCyclesWavesCommand}"        Margin="0,0,0,4"/>
                                <Button Content="Ephemeris"           HorizontalAlignment="Stretch" Command="{Binding SelectEphemerisCommand}"          Margin="0,0,0,4"/>
                                <Button Content="Eclipses"            HorizontalAlignment="Stretch" Command="{Binding SelectEclipsesCommand}"           Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowCalculatorsButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Julian Day"    HorizontalAlignment="Stretch" Command="{Binding SelectCalculatorsJulianDayCommand}"  Margin="0,0,0,4"/>
                                <Button Content="Obliquity"     HorizontalAlignment="Stretch" Command="{Binding SelectCalculatorsObliquityCommand}"  Margin="0,0,0,4"/>
                                <Button Content="Sidereal Time" HorizontalAlignment="Stretch" IsEnabled="False"                                       Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowProgressiveButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Events"    HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveEventsCommand}"    Margin="0,0,0,4"/>
                                <Button Content="Transit"   HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveTransitCommand}"   Margin="0,0,0,4"/>
                                <Button Content="Secondary" HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSecondaryCommand}" Margin="0,0,0,4"/>
                                <Button Content="Symbolic"       HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSymbolicCommand}"       Margin="0,0,0,4"/>
                                <Button Content="Log Time Scale" HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveLogTimeScaleCommand}" Margin="0,0,0,4"/>
                                <Button Content="Age Point"      HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveAgePointCommand}"     Margin="0,0,0,4"/>
                                <Button Content="Solar Return"        HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSolarCommand}"   Margin="0,0,0,4"/>
                                <Button Content="Primary Directions"  HorizontalAlignment="Stretch" Command="{Binding SelectProgressivePrimDirCommand}" Margin="0,0,0,4"/>
                                <Button Content="Pre-Natal Events"    HorizontalAlignment="Stretch" Command="{Binding SelectProgressivePreNatalCommand}"  Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right area: single pane or split pane -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Main view -->
                <Border Grid.Column="0"
                        Grid.ColumnSpan="{Binding MainViewColumnSpan}"
                        Margin="12,12,6,12"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <TextBlock Text="View 1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView1Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentMainViewModel}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#C8C8C8"
                              ResizeDirection="Columns"
                              ShowsPreview="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}"/>

                <Border Grid.Column="2"
                        Margin="6,12,12,12"
                        BorderThickness="1"
                        Padding="12"
                        Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="View 2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView2Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentDetailViewModel}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
