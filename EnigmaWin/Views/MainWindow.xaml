<Window x:Class="EnigmaWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EnigmaWin.ViewModels"
        xmlns:nav="clr-namespace:EnigmaWin.Sources.AppShell.Navigation"
        xmlns:layout="clr-namespace:EnigmaWin.Sources.Features.Shared.Layout"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="EnigmaWin"
        Width="1100" Height="700">

    <!-- Keyboard shortcuts, as in the Apple version: Ctrl+Shift+digit activates a mode (Cmd+Shift there),
         Alt+digit opens a sub-item (Cmd+Option there). -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Shift+D1" Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Radix}"/>
        <KeyBinding Gesture="Ctrl+Shift+D2" Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Progressive}"/>
        <KeyBinding Gesture="Ctrl+Shift+D3" Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Cycles}"/>
        <KeyBinding Gesture="Ctrl+Shift+D4" Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Config}"/>
        <KeyBinding Gesture="Alt+D1" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixOverview}"/>
        <KeyBinding Gesture="Alt+D2" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixPositions}"/>
        <KeyBinding Gesture="Alt+D3" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixAnalysis}"/>
        <KeyBinding Gesture="Alt+D4" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixSearch}"/>
        <KeyBinding Gesture="Alt+D5" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ResearchProjects}"/>
        <KeyBinding Gesture="Alt+D7" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesAstronomical}"/>
        <KeyBinding Gesture="Alt+D8" Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesWaves}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- A row in the sidebar; the selected row (current location) is highlighted. -->
        <Style x:Key="SidebarRowStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Width="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="Icon" Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="8,12,0,4"/>
        </Style>

        <DataTemplate x:Key="SidebarRowTemplate">
            <Button Style="{StaticResource SidebarRowStyle}" Command="{Binding Command}"/>
        </DataTemplate>

        <ControlTemplate x:Key="MenuSeparatorTemplate" TargetType="MenuItem">
            <Separator/>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu bar: same menus and order as the Apple version. -->
        <Menu Grid.Row="0">

            <MenuItem Header="{Binding Labels.File}">
                <MenuItem Header="{Binding Labels.Activate[ImportExport]}"
                          Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.ImportExport}"/>
                <MenuItem Header="{Binding Labels.Sections[ImportExportEnigma]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ImportExportEnigma}"/>
                <MenuItem Header="{Binding Labels.Sections[ImportExportQuickChart]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ImportExportQuickChart}"/>
                <MenuItem Header="{Binding Labels.Sections[ImportExportAaf]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ImportExportAaf}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.Settings}" Click="OnSettingsClicked"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.Exit}" Click="OnExitClicked"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Modes[Radix]}">
                <MenuItem Header="{Binding Labels.Activate[Radix]}" InputGestureText="Ctrl+Shift+1"
                          Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Radix}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.Sections[RadixOverview]}" InputGestureText="Alt+1"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixOverview}"/>
                <MenuItem Header="{Binding Labels.Sections[RadixPositions]}" InputGestureText="Alt+2"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixPositions}"/>
                <MenuItem Header="{Binding Labels.Sections[RadixAnalysis]}" InputGestureText="Alt+3"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixAnalysis}"/>
                <MenuItem Header="{Binding Labels.Sections[RadixSearch]}" InputGestureText="Alt+4"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.RadixSearch}"/>
            </MenuItem>

            <!-- All analyses, grouped as defined in AnalysisCatalog (same grouping as the analysis screen). -->
            <MenuItem Header="{Binding Labels.Analysis}" ItemsSource="{Binding AnalysisMenu}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding HeaderText}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Modes[Progressive]}">
                <MenuItem Header="{Binding Labels.Activate[Progressive]}" InputGestureText="Ctrl+Shift+2"
                          Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Progressive}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveEvents]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveEvents}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressivePrimary]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressivePrimary}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveSecondary]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveSecondary}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveTransit]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveTransit}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveSymbolic]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveSymbolic}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveSolar]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveSolar}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressivePrenatal]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressivePrenatal}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveLogTimeScale]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveLogTimeScale}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveAgePoint]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveAgePoint}"/>
                <MenuItem Header="{Binding Labels.Sections[ProgressiveCalendar]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ProgressiveCalendar}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Modes[Cycles]}">
                <MenuItem Header="{Binding Labels.Activate[Cycles]}" InputGestureText="Ctrl+Shift+3"
                          Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Cycles}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.Sections[CyclesAstronomical]}" InputGestureText="Alt+7"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesAstronomical}"/>
                <MenuItem Header="{Binding Labels.Sections[CyclesWaves]}" InputGestureText="Alt+8"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesWaves}"/>
                <MenuItem Header="{Binding Labels.Sections[CyclesMonthlyEphemeris]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesMonthlyEphemeris}"/>
                <MenuItem Header="{Binding Labels.Sections[CyclesLongTimeEphemeris]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesLongTimeEphemeris}"/>
                <MenuItem Header="{Binding Labels.Sections[CyclesEclipses]}"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.CyclesEclipses}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Modes[Research]}">
                <MenuItem Header="{Binding Labels.Sections[ResearchProjects]}" InputGestureText="Alt+5"
                          Command="{Binding OpenSectionCommand}" CommandParameter="{x:Static nav:NavSection.ResearchProjects}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Modes[Config]}">
                <MenuItem Header="{Binding Labels.Activate[Config]}" InputGestureText="Ctrl+Shift+4"
                          Command="{Binding ActivateModeCommand}" CommandParameter="{x:Static nav:AppMode.Config}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Help}">
                <MenuItem Header="{Binding Labels.HelpGlyphOverview}" Click="OnGlyphOverviewClicked"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.HelpAbout}" Click="OnAboutClicked"/>
            </MenuItem>

        </Menu>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation sidebar: all work modes, then the sub-items of the active mode. -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="8,12"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="{Binding Labels.SidebarTitle}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"/>

                        <TextBlock Text="{Binding Labels.SidebarModes}" Style="{StaticResource SidebarHeaderStyle}"/>
                        <ItemsControl ItemsSource="{Binding SidebarModes}" ItemTemplate="{StaticResource SidebarRowTemplate}"
                                      Focusable="False"/>

                        <StackPanel Visibility="{Binding HasSidebarSections, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SidebarSectionsTitle}" Style="{StaticResource SidebarHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding SidebarSections}" ItemTemplate="{StaticResource SidebarRowTemplate}"
                                          Focusable="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right area: single pane or split pane -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Drill-down from the analysis overview: back to the grouped list. -->
                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Left" Margin="12,8,0,0" Padding="8,3"
                        Command="{Binding BackToAnalysisCommand}"
                        Visibility="{Binding ShowBackToAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Labels.Analysis}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Main view -->
                <!-- Both panes are at least as wide as their widest input row (InputColumn), as in the Apple version. -->
                <Border Grid.Row="1" Grid.Column="0"
                        layout:InputColumn.FitsInputRows="True"
                        Grid.ColumnSpan="{Binding MainViewColumnSpan}"
                        Margin="12,12,6,12"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <TextBlock Text="{Binding Labels.View1}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView1Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentMainViewModel}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Grid.Column="1"
                              Width="6"
                              Background="#C8C8C8"
                              ResizeDirection="Columns"
                              ShowsPreview="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}"/>

                <Border Grid.Row="1" Grid.Column="2"
                        layout:InputColumn.FitsInputRows="True"
                        Margin="6,12,12,12"
                        BorderThickness="1"
                        Padding="12"
                        Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Labels.View2}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView2Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentDetailViewModel}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
