<Window x:Class="EnigmaWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EnigmaWin.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="EnigmaWin"
        Width="1100" Height="700">

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row="0">

            <MenuItem Header="{Binding Labels.Radix}" Command="{Binding SelectRadixCommand}">
                <MenuItem Header="{Binding Labels.RadixNewChart}"    Command="{Binding NewChartCommand}"/>
                <MenuItem Header="{Binding Labels.RadixOverview}"     Command="{Binding ShowOverviewCommand}"/>
                <MenuItem Header="{Binding Labels.RadixPositions}"    Command="{Binding ShowPositionsCommand}"/>
                <MenuItem Header="{Binding Labels.RadixSearch}"       Command="{Binding SearchRadixCommand}"/>
                <MenuItem Header="{Binding Labels.RadixAnalysis}"     Command="{Binding ShowAnalysisCommand}"/>
                <MenuItem Header="{Binding Labels.RadixDeclinations}" Command="{Binding ShowDeclinationsCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.BackView1}" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="{Binding Labels.BackView2}" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Config}" Command="{Binding SelectConfigurationCommand}">
                <MenuItem Header="{Binding Labels.ConfigOverview}" Command="{Binding SelectConfigurationCommand}"/>
                <MenuItem Header="{Binding Labels.ConfigNew}"  Command="{Binding NewConfigurationCommand}"/>
                <MenuItem Header="{Binding Labels.ConfigEdit}" Command="{Binding EditConfigurationCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.BackView1}" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="{Binding Labels.BackView2}" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Research}" Command="{Binding SelectResearchCommand}">
                <MenuItem Header="{Binding Labels.ResearchProjects}" Command="{Binding SelectResearchProjectsCommand}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Periods}" Command="{Binding SelectCyclesCommand}">
                <MenuItem Header="{Binding Labels.PeriodsAstronomical}" Command="{Binding SelectCyclesAstronomicalCommand}"/>
                <MenuItem Header="{Binding Labels.PeriodsWaves}"               Command="{Binding SelectCyclesWavesCommand}"/>
                <MenuItem Header="{Binding Labels.PeriodsMonthlyEphemeris}"   Command="{Binding SelectEphemerisCommand}"/>
                <MenuItem Header="{Binding Labels.PeriodsLongTimeEphemeris}" Command="{Binding SelectLongTimeEphemerisCommand}"/>
                <MenuItem Header="{Binding Labels.PeriodsEclipses}"            Command="{Binding SelectEclipsesCommand}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Calculators}" Command="{Binding SelectCalculatorsCommand}">
                <MenuItem Header="{Binding Labels.CalculatorsJulianDay}"    Command="{Binding SelectCalculatorsJulianDayCommand}"/>
                <MenuItem Header="{Binding Labels.CalculatorsObliquity}"     Command="{Binding SelectCalculatorsObliquityCommand}"/>
                <MenuItem Header="{Binding Labels.CalculatorsSiderealTime}" IsEnabled="False"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Progressive}" Command="{Binding SelectProgressiveCommand}">
                <MenuItem Header="{Binding Labels.ProgressiveEvents}"    Command="{Binding SelectProgressiveEventsCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveTransit}"   Command="{Binding SelectProgressiveTransitCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveSecondary}" Command="{Binding SelectProgressiveSecondaryCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveSymbolic}"           Command="{Binding SelectProgressiveSymbolicCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveLogTimeScale}"    Command="{Binding SelectProgressiveLogTimeScaleCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveAgePoint}"         Command="{Binding SelectProgressiveAgePointCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveSolarReturn}"      Command="{Binding SelectProgressiveSolarCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressivePrimDir}" Command="{Binding SelectProgressivePrimDirCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressivePreNatal}"   Command="{Binding SelectProgressivePreNatalCommand}"/>
                <MenuItem Header="{Binding Labels.ProgressiveCalendar}" Command="{Binding SelectProgressiveCalendarCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding Labels.BackView1}" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="{Binding Labels.BackView2}" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Synastry}" Command="{Binding SelectSynastryCommand}"/>

            <MenuItem Header="{Binding Labels.ImportExport}" Command="{Binding SelectImportExportCommand}">
                <MenuItem Header="{Binding Labels.ImportExportEnigma}"     Command="{Binding SelectImportExportEnigmaCommand}"/>
                <MenuItem Header="{Binding Labels.ImportExportQuickChart}" Command="{Binding SelectImportExportQuickChartCommand}"/>
                <MenuItem Header="{Binding Labels.ImportExportAaf}"        Command="{Binding SelectImportExportAafCommand}"/>
            </MenuItem>

            <MenuItem Header="{Binding Labels.Help}">
                <MenuItem Header="{Binding Labels.HelpGlyphOverview}" Click="OnGlyphOverviewClicked"/>
                <MenuItem Header="{Binding Labels.HelpAbout}" Click="OnAboutClicked"/>
            </MenuItem>

        </Menu>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation sidebar -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="EnigmaWin" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Labels.SidebarNavigation}" Opacity="0.7"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Labels.SidebarWorkspace}" FontSize="12" Opacity="0.75" Margin="0,0,0,4"/>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectRadixCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Radix}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectConfigurationCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Config}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectResearchCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Research}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectCyclesCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Periods}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectCalculatorsCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Calculators}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectProgressiveCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Progressive}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectSynastryCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.Synastry}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavItemStyle}"
                                    Command="{Binding SelectImportExportCommand}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Labels.ImportExport}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" BorderThickness="1" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Labels.SidebarActions}" FontSize="12" Opacity="0.75" Margin="0,0,0,6"/>
                            <Button Content="{Binding Labels.BackView1}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackMainCommand}"
                                    IsEnabled="{Binding CanGoBackMain}"
                                    Margin="0,0,0,4"/>
                            <Button Content="{Binding Labels.BackView2}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackDetailCommand}"
                                    IsEnabled="{Binding CanGoBackDetail}"
                                    Margin="0,0,0,4"/>

                            <StackPanel Visibility="{Binding ShowRadixButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.RadixNewChart}"   Command="{Binding NewChartCommand}"       HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.RadixOverview}"    Command="{Binding ShowOverviewCommand}"   HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.RadixPositions}"   Command="{Binding ShowPositionsCommand}"  HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.RadixSearch}"      Command="{Binding SearchRadixCommand}"    HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.RadixAnalysis}"    Command="{Binding ShowAnalysisCommand}"   HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowConfigurationButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.ConfigNew}"  HorizontalAlignment="Stretch" Command="{Binding NewConfigurationCommand}"  Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ConfigEdit}" HorizontalAlignment="Stretch" Command="{Binding EditConfigurationCommand}" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowResearchButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.ResearchProjects}" HorizontalAlignment="Stretch" Command="{Binding SelectResearchProjectsCommand}" Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowCyclesButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.PeriodsAstronomical}" HorizontalAlignment="Stretch" Command="{Binding SelectCyclesAstronomicalCommand}" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.PeriodsWaves}"               HorizontalAlignment="Stretch" Command="{Binding SelectCyclesWavesCommand}"        Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.PeriodsMonthlyEphemeris}"   HorizontalAlignment="Stretch" Command="{Binding SelectEphemerisCommand}"          Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.PeriodsLongTimeEphemeris}" HorizontalAlignment="Stretch" Command="{Binding SelectLongTimeEphemerisCommand}"  Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.PeriodsEclipses}"            HorizontalAlignment="Stretch" Command="{Binding SelectEclipsesCommand}"           Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowCalculatorsButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.CalculatorsJulianDay}"    HorizontalAlignment="Stretch" Command="{Binding SelectCalculatorsJulianDayCommand}"  Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.CalculatorsObliquity}"     HorizontalAlignment="Stretch" Command="{Binding SelectCalculatorsObliquityCommand}"  Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.CalculatorsSiderealTime}" HorizontalAlignment="Stretch" IsEnabled="False"                                       Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowImportExportButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.ImportExportEnigma}"     HorizontalAlignment="Stretch" Command="{Binding SelectImportExportEnigmaCommand}"     Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ImportExportQuickChart}" HorizontalAlignment="Stretch" Command="{Binding SelectImportExportQuickChartCommand}" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ImportExportAaf}"        HorizontalAlignment="Stretch" Command="{Binding SelectImportExportAafCommand}"        Margin="0,0,0,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowProgressiveButtons, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding Labels.ProgressiveEvents}"    HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveEventsCommand}"    Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveTransit}"   HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveTransitCommand}"   Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveSecondary}" HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSecondaryCommand}" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveSymbolic}"       HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSymbolicCommand}"       Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveLogTimeScale}" HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveLogTimeScaleCommand}" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveAgePoint}"      HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveAgePointCommand}"     Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveSolarReturn}"        HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveSolarCommand}"   Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressivePrimDir}"  HorizontalAlignment="Stretch" Command="{Binding SelectProgressivePrimDirCommand}" Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressivePreNatal}"    HorizontalAlignment="Stretch" Command="{Binding SelectProgressivePreNatalCommand}"  Margin="0,0,0,4"/>
                                <Button Content="{Binding Labels.ProgressiveCalendar}" HorizontalAlignment="Stretch" Command="{Binding SelectProgressiveCalendarCommand}" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Right area: single pane or split pane -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Main view -->
                <Border Grid.Column="0"
                        Grid.ColumnSpan="{Binding MainViewColumnSpan}"
                        Margin="12,12,6,12"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <TextBlock Text="{Binding Labels.View1}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView1Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentMainViewModel}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#C8C8C8"
                              ResizeDirection="Columns"
                              ShowsPreview="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}"/>

                <Border Grid.Column="2"
                        Margin="6,12,12,12"
                        BorderThickness="1"
                        Padding="12"
                        Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Labels.View2}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowView2Placeholder, Converter={StaticResource BoolToVisibility}}"/>
                        <ContentControl Content="{Binding CurrentDetailViewModel}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
