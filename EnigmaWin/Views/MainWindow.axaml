<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EnigmaWin.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="EnigmaWin.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EnigmaWin"
        Width="1100" Height="700">

    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Standard Windows menu bar -->
        <Menu Grid.Row="0">

            <MenuItem Header="Radix" Command="{Binding SelectRadixCommand}">
                <MenuItem Header="New Chart"  Command="{Binding NewChartCommand}"/>
                <MenuItem Header="Overzicht"  Command="{Binding ShowOverviewCommand}"/>
                <MenuItem Header="Posities"   Command="{Binding ShowPositionsCommand}"/>
                <MenuItem Header="Zoek"       Command="{Binding SearchRadixCommand}"/>
                <MenuItem Header="Analyse"    Command="{Binding ShowAnalysisCommand}"/>
                <MenuItem Header="Declinations" Command="{Binding ShowDeclinationsCommand}"/>
                <Separator/>
                <MenuItem Header="Back View 1" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="Back View 2" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="Configuration" Command="{Binding SelectConfigurationCommand}">
                <MenuItem Header="Overview"           Command="{Binding SelectConfigurationCommand}"/>
                <MenuItem Header="New Configuration"  Command="{Binding NewConfigurationCommand}"/>
                <MenuItem Header="Edit Configuration" Command="{Binding EditConfigurationCommand}"/>
                <Separator/>
                <MenuItem Header="Back View 1" Command="{Binding BackMainCommand}"   IsEnabled="{Binding CanGoBackMain}"/>
                <MenuItem Header="Back View 2" Command="{Binding BackDetailCommand}" IsEnabled="{Binding CanGoBackDetail}"/>
            </MenuItem>

            <MenuItem Header="Research" Command="{Binding SelectResearchCommand}">
                <MenuItem Header="Projects" Command="{Binding SelectResearchProjectsCommand}"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Click="OnAboutClicked"/>
            </MenuItem>

        </Menu>

        <!-- Main content area -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*">

            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="EnigmaWin" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Navigation" Opacity="0.7"/>
                        </StackPanel>

                        <Border BorderThickness="0,0,0,1"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Workspace" FontSize="12" Opacity="0.75"/>

                            <Button Classes.nav-item="True"
                                    Classes.accent="{Binding ShowRadixButtons}"
                                    Command="{Binding SelectRadixCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1">
                                        <TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="Radix" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes.nav-item="True"
                                    Classes.accent="{Binding ShowConfigurationButtons}"
                                    Command="{Binding SelectConfigurationCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1">
                                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes.nav-item="True"
                                    Classes.accent="{Binding ShowResearchButtons}"
                                    Command="{Binding SelectResearchCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1">
                                        <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="Research" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" BorderThickness="1,1,1,0" Padding="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Actions" FontSize="12" Opacity="0.75"/>
                            <Button Content="Back View 1"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackMainCommand}"
                                    IsEnabled="{Binding CanGoBackMain}"/>
                            <Button Content="Back View 2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BackDetailCommand}"
                                    IsEnabled="{Binding CanGoBackDetail}"/>

                            <StackPanel IsVisible="{Binding ShowRadixButtons}" Spacing="8">
                                <Button Content="New Chart" Command="{Binding NewChartCommand}" HorizontalAlignment="Stretch" Classes="accent"/>
                                <Button Content="Overzicht" Command="{Binding ShowOverviewCommand}" HorizontalAlignment="Stretch"/>
                                <Button Content="Posities" Command="{Binding ShowPositionsCommand}" HorizontalAlignment="Stretch"/>
                                <Button Content="Zoek" Command="{Binding SearchRadixCommand}" HorizontalAlignment="Stretch"/>
                                <Button Content="Analyse" Command="{Binding ShowAnalysisCommand}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowConfigurationButtons}" Spacing="8">
                                <Button Content="New Configuration"
                                        HorizontalAlignment="Stretch"
                                        Classes="accent"
                                        Command="{Binding NewConfigurationCommand}"/>
                                <Button Content="Edit Configuration"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding EditConfigurationCommand}"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowResearchButtons}" Spacing="8">
                                <Button Content="Projects"
                                        HorizontalAlignment="Stretch"
                                        Classes="accent"
                                        Command="{Binding SelectResearchProjectsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right area: single pane (Research) or split pane (Radix/Config) -->
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto,*">

                <!-- Main view — full width when detail pane hidden, left half when shown -->
                <Border Margin="12,12,6,12" CornerRadius="8" BorderThickness="1" Padding="12"
                        Grid.Column="0"
                        Grid.ColumnSpan="{Binding MainViewColumnSpan}">
                    <Grid>
                        <TextBlock Text="View 1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ShowView1Placeholder}"/>
                        <ContentControl Content="{Binding CurrentMainViewModel}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#C8C8C8"
                              ResizeDirection="Columns"
                              ShowsPreview="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="{Binding ShowDetailPane}"/>

                <Border Grid.Column="2" Margin="6,12,12,12" CornerRadius="8" BorderThickness="1" Padding="12"
                        IsVisible="{Binding ShowDetailPane}">
                    <Grid>
                        <TextBlock Text="View 2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ShowView2Placeholder}"/>
                        <ContentControl Content="{Binding CurrentDetailViewModel}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>
