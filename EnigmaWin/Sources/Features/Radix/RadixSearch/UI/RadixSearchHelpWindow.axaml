<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixSearch.UI"
        x:Class="EnigmaWin.Sources.Features.Radix.RadixSearch.UI.RadixSearchHelpWindow"
        x:DataType="ui:RadixSearchHelpWindow"
        Title="{Binding LabelTitle}"
        Width="480" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap"/>
        <Button Content="{Binding LabelClose}"
                HorizontalAlignment="Right"
                Click="OnCloseClicked"/>
    </StackPanel>
</Window>
