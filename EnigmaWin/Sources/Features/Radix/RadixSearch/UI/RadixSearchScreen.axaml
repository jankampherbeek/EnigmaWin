<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixSearch.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="600"
             x:DataType="ui:RadixSearchViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixSearch.UI.RadixSearchScreen">

    <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="12">

        <!-- Title row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding LabelTitle}"
                       FontSize="24" FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Content="?"
                    ToolTip.Tip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Search row -->
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LabelPartOfName}"
                           VerticalAlignment="Center"
                           MinWidth="120"/>
                <TextBox Text="{Binding SearchText}"
                         MinWidth="200"
                         x:Name="SearchBox"/>
                <Button Content="{Binding LabelSearch}"
                        Click="OnSearchClicked"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2">

            <!-- No results label -->
            <TextBlock Text="{Binding LabelNoResults}"
                       IsVisible="{Binding HasNoResults}"
                       Margin="0,8,0,0"
                       Opacity="0.7"/>

            <!-- Results table -->
            <ScrollViewer IsVisible="{Binding HasResults}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">

                    <!-- Column headers -->
                    <Border BorderThickness="0,0,0,1" Padding="4,0,4,6">
                        <Grid ColumnDefinitions="200,180,140,90,90">
                            <TextBlock Grid.Column="0" Text="{Binding LabelColName}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColDateTime}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColLocation}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text=""  FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text=""  FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Result rows -->
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:HoroscopeSearchRow">
                                <Grid ColumnDefinitions="200,180,140,90,90"
                                      Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayDateTime}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayLocation}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <Button Grid.Column="3"
                                            Content="{Binding LabelSelect}"
                                            Click="OnSelectClicked"
                                            Margin="2,1"
                                            Classes="accent"/>
                                    <Button Grid.Column="4"
                                            Content="{Binding LabelDelete}"
                                            Click="OnDeleteClicked"
                                            Margin="2,1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
