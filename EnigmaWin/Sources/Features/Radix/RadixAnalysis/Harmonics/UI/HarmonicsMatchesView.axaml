<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:HarmonicsMatchesViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI.HarmonicsMatchesView">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Top navigation bar: title + help button -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button ToolTip.Tip="{Binding TooltipFactsheet}"
                            Click="OnFactsheetClicked">
                        <Image Source="avares://EnigmaWin/Assets/factsheet.png" Width="16" Height="16"/>
                    </Button>
                    <Button Content="?"
                            ToolTip.Tip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       IsVisible="{Binding HasNoData}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Data -->
            <ScrollViewer IsVisible="{Binding HasData}">
                <Border BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel Spacing="0">

                        <!-- Column headers -->
                        <Grid ColumnDefinitions="40,40,80,80" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding LabelRadixFactor}"    FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelHarmonicFactor}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelOrb}"            FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelExactness}"      FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,0,0,2"/>

                        <!-- Match rows -->
                        <ItemsControl ItemsSource="{Binding MatchRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:HarmonicsMatchesViewModel+MatchRow">
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="40,40,80,80" Margin="0,3,0,3">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RadixGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding HarmonicGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding OrbText}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ExactnessText}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
