<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:HarmonicsDrawingViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI.HarmonicsDrawingView">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Top navigation bar: title + action buttons -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsBlackWhite}"
                                  Command="{Binding ToggleBlackWhiteCommand}"
                                  ToolTip.Tip="{Binding LabelBtnBlackWhite}">
                        <Image Source="avares://EnigmaWin/Assets/color.png" Width="16" Height="16"/>
                    </ToggleButton>
                    <Button Content="{Binding LabelBtnExport}"
                            Click="OnExportClicked"/>
                    <Button ToolTip.Tip="{Binding TooltipFactsheet}"
                            Click="OnFactsheetClicked">
                        <Image Source="avares://EnigmaWin/Assets/factsheet.png" Width="16" Height="16"/>
                    </Button>
                    <Button Content="?"
                            ToolTip.Tip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart canvas -->
        <ui:HarmonicsWheelCanvas Grid.Row="1"
                                  PlotData="{Binding PlotData}"
                                  Theme="{Binding Theme}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>

    </Grid>
</UserControl>
