<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI"
        x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Harmonics.UI.HarmonicsDrawingHelpWindow"
        x:DataType="ui:HarmonicsDrawingHelpWindow"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="16" Margin="20">

        <ItemsControl ItemsSource="{Binding HelpParagraphs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{Binding LabelClose}"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Click="OnCloseClicked"/>

    </StackPanel>
</Window>
