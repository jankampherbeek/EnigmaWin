<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Enneagram.UI.EnneagramScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Enneagram.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="24" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
        </Grid>

        <!-- Tab buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{Binding LabelBtnOverview}"
                    Command="{Binding ShowOverviewCommand}"
                    Padding="12,4" Margin="0,0,4,0"/>
            <Button Content="{Binding LabelBtnDetails}"
                    Command="{Binding ShowDetailsCommand}"
                    Padding="12,4"/>
        </StackPanel>

        <!-- Tab content -->
        <Grid Grid.Row="2">

            <!-- No chart message (shown on both tabs when no data) -->
            <TextBlock Text="{Binding LabelNoChart}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontStyle="Italic" Opacity="0.6"/>

            <!-- Overview tab: diagram on top, ranked list below -->
            <Grid Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Enneagram diagram -->
                <Border Grid.Row="0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"
                        Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                    <ui:EnneagramCanvas
                        Circles="{Binding Circles}"
                        Lines="{Binding Lines}"
                        Background="White"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </Border>

                <!-- Ranked type list below diagram -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                    <Border BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelColType}"     FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelColName}"     FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding LabelColStrength}" FontWeight="SemiBold" TextAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,0,0,2"/>
                            <ItemsControl ItemsSource="{Binding TypeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Type}"                      FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"                      FontSize="13"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Strength, StringFormat=F4}" FontSize="13" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Details tab: factor table -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <Border BorderThickness="1" CornerRadius="4" Padding="8"
                        Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"  Text="{Binding LabelColFactor}"   FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"  Text="{Binding LabelColPosition}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2"  Text="#"  FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3"  Text="1"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4"  Text="2"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5"  Text="3"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6"  Text="4"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="7"  Text="5"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="8"  Text="6"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="9"  Text="7"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="10" Text="8"  FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="11" Text="9"  FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding DetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"  Text="{Binding FactorName}"          FontSize="12"/>
                                            <TextBlock Grid.Column="1"  Text="{Binding PositionType}"        FontSize="12"/>
                                            <TextBlock Grid.Column="2"  Text="{Binding Position}"            FontSize="12" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3"  Text="{Binding F1, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4"  Text="{Binding F2, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5"  Text="{Binding F3, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6"  Text="{Binding F4, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="7"  Text="{Binding F5, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="8"  Text="{Binding F6, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="9"  Text="{Binding F7, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="10" Text="{Binding F8, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="11" Text="{Binding F9, StringFormat=F3}" FontSize="12" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
