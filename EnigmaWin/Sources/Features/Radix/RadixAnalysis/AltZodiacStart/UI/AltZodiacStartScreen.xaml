<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.AltZodiacStart.UI.AltZodiacStartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.AltZodiacStart.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:AltZodiacStartViewModel}"
             d:DesignWidth="700" d:DesignHeight="640">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + tab buttons + action buttons -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LabelTitle}"
                               FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="{Binding LabelBtnPositions}"
                            Command="{Binding ShowPositionsCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding LabelBtnWheel}"
                            Command="{Binding ShowWheelCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsBlackWhite, Mode=OneWay}"
                                  Command="{Binding ToggleBlackWhiteCommand}"
                                  ToolTip="{Binding LabelBtnBlackWhite}"
                                  Content="B/W" Margin="0,0,4,0"/>
                    <ToggleButton IsChecked="{Binding AspectsHidden, Mode=OneWay}"
                                  Command="{Binding ToggleAspectsCommand}"
                                  ToolTip="{Binding LabelBtnAspects}"
                                  Content="∠" Margin="0,0,4,0"/>
                    <Button Content="💾" ToolTip="{Binding LabelBtnExport}"
                            IsEnabled="{Binding HasRows}"
                            Margin="0,0,4,0" Click="OnExportClicked"/>
                    <Button Content="📄" ToolTip="{Binding TooltipFactsheet}"
                            Margin="0,0,4,0" Click="OnFactsheetClicked"/>
                    <Button Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Start factor -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,0"
                    Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding LabelStartFactor}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding StartFactorGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding StartFactorName}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding LabelNoChart}"
                       Visibility="{Binding HasNoChart, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontStyle="Italic" Opacity="0.6" Margin="8"/>
            <TextBlock Text="{Binding LabelNoResults}"
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontStyle="Italic" Opacity="0.6" Margin="8"/>

            <Grid Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">

                <!-- Positions tab -->
                <ScrollViewer Visibility="{Binding ShowPositions, Converter={StaticResource BoolToVisibility}}"
                              Margin="8">
                    <Border BorderThickness="1" CornerRadius="4" Padding="10" HorizontalAlignment="Left">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding LabelColOriginal}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding LabelColShifted}"  FontWeight="SemiBold"/>
                            </Grid>
                            <Separator Margin="0,0,0,2"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:AltZodiacStartRow}">
                                        <Border x:Name="RowBorder"
                                                Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FactorGlyph}" FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OriginalDms}" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OriginalSignGlyph}" FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="14" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ShiftedDms}" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ShiftedSignGlyph}" FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="14" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Highlight the row of the factor that defines the new zodiac's 0°. -->
                                            <DataTrigger Binding="{Binding IsStartFactor}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Wheel tab -->
                <ui:AltZodiacStartWheelCanvas
                    Visibility="{Binding ShowWheel, Converter={StaticResource BoolToVisibility}}"
                    DrawingType="{Binding DrawingType}"
                    PlotData="{Binding PlotData}"
                    ZodiacStartLongitude="{Binding ZodiacStartLongitude}"
                    Theme="{Binding Theme}"
                    ShowAspects="{Binding ShowAspects}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="8"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
