<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:OccupiedMidpointsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI.OccupiedMidpointsView">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Title row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0"
                       Text="{Binding LabelTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Content="?"
                    ToolTip.Tip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       IsVisible="{Binding HasNoData}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Data: canvas + list -->
            <ScrollViewer IsVisible="{Binding HasData}">
                <StackPanel Spacing="12">

                    <!-- Midpoint tree canvas -->
                    <ui:MidpointTreePanelControl Matches="{Binding Matches}"
                                                 HorizontalAlignment="Stretch"
                                                 Margin="0,0,0,4"/>

                    <Separator/>

                    <!-- Match list -->
                    <Border BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Spacing="0">

                            <!-- Column headers -->
                            <Grid ColumnDefinitions="32,32,160,32,80,80" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{Binding LabelFactor1}"  FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelFactor2}"  FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding LabelMidpoint}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelPlanet}"   FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelOrb}"      FontWeight="SemiBold" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,0,0,2"/>

                            <!-- Match rows -->
                            <ItemsControl ItemsSource="{Binding MatchRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:OccupiedMidpointsViewModel+MatchRow">
                                        <Grid ColumnDefinitions="32,32,160,32,80,80" Margin="0,3,0,3">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph1}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph2}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                <TextBlock Text="{Binding MidpointSignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PlanetGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding OrbText}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding ExactnessText}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
