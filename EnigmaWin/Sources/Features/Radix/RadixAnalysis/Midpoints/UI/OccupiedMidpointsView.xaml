<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI.OccupiedMidpointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="600">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar with factsheet + help buttons -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="{Binding TooltipFactsheet}" Content="📄"
                            Margin="0,0,4,0"
                            Click="OnFactsheetClicked"/>
                    <Button Content="?"
                            ToolTip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Data: tree panel + match list -->
            <ScrollViewer Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Midpoint tree canvas -->
                    <ui:MidpointTreePanelControl Matches="{Binding Matches}"
                                                 HorizontalAlignment="Stretch"
                                                 Margin="0,0,0,4"/>

                    <Separator Margin="0,8,0,8"/>

                    <!-- Match list -->
                    <Border BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelFactor1}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelFactor2}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding LabelMidpoint}"  FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelPlanet}"    FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelOrb}"       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,0,0,2"/>

                            <!-- Match rows -->
                            <ItemsControl ItemsSource="{Binding MatchRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Glyph1}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Glyph2}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                    <TextBlock Text="{Binding MidpointSignGlyph}"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="16"
                                                               Margin="2,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding PlanetGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding OrbText}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding ExactnessText}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
