<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.UI.RadixAnalysisScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="16" VerticalAlignment="Top" HorizontalAlignment="Left">
        <TextBlock Text="{Binding LabelTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Button Content="{Binding LabelBtnAspects}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowAspectsCommand}"/>
        <Button Content="{Binding LabelBtnBlaSchema}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowBlaSchemaCommand}"/>
        <Button Content="{Binding LabelBtnMidpoints}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowMidpointsCommand}"/>
        <Button Content="{Binding LabelBtnHarmonics}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowHarmonicsCommand}"/>
        <Button Content="{Binding LabelBtnDeclinations}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowDeclinationsCommand}"/>
        <Button Content="{Binding LabelBtnZodiacDivisions}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowZodiacDivisionsCommand}"/>
        <Button Content="{Binding LabelBtnEnneagram}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowEnneagramCommand}"/>
        <Button Content="{Binding LabelBtnVsp}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowVspCommand}"/>
        <Button Content="{Binding LabelBtnFixStars}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowFixStarsCommand}"/>
        <Button Content="{Binding LabelBtnParans}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6" Margin="0,0,0,4"
                Command="{Binding ShowParansCommand}"/>
        <Button Content="{Binding LabelBtnCountings}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="8,6"
                Command="{Binding ShowCountingsCommand}"/>
    </StackPanel>
</UserControl>
