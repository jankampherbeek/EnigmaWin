<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:DataType="ui:RadixAnalysisViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.UI.RadixAnalysisScreen">
    <StackPanel Margin="16" Spacing="12" VerticalAlignment="Top" HorizontalAlignment="Left">
        <TextBlock Text="Analyse" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 8"/>
        <Button Content="Aspecten"
                HorizontalAlignment="Stretch"
                Classes="bordered"
                Command="{Binding ShowAspectsCommand}"/>
        <Button Content="Midpunten"
                HorizontalAlignment="Stretch"
                Classes="bordered"
                Command="{Binding ShowMidpointsCommand}"/>
    </StackPanel>
</UserControl>
