<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.HarmonicExactAspects.UI.HarmonicExactAspectsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelHeaderTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="📄" ToolTip="{Binding TooltipFactsheet}" Click="OnFactsheetClicked"
                    Margin="0,0,4,0" VerticalAlignment="Top"/>
            <Button Grid.Column="2" Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked" VerticalAlignment="Top"/>
        </Grid>

        <!-- Options -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">

            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="{Binding LabelFactorsSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <CheckBox Content="{Binding LabelIncludeAscendant}" IsChecked="{Binding IncludeAscendant, Mode=TwoWay}" Margin="0,0,0,2"/>
                <CheckBox Content="{Binding LabelIncludeMc}" IsChecked="{Binding IncludeMc, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="{Binding LabelAspectsSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <RadioButton GroupName="HarmonicExactAspectsSet" Content="{Binding LabelConfiguredAspects}"
                             IsChecked="{Binding UseConfiguredAspects, Mode=TwoWay}" Margin="0,0,0,2"/>
                <RadioButton GroupName="HarmonicExactAspectsSet" Content="{Binding LabelMajorAspects}"
                             IsChecked="{Binding UseMajorAspects, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding LabelMaxHarmonic}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Width="24" Command="{Binding DecreaseMaxHarmonicCommand}"/>
                    <TextBox Width="48" Margin="4,0" TextAlignment="Right" VerticalContentAlignment="Center"
                             Text="{Binding MaxHarmonic, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             KeyDown="OnMaxHarmonicKeyDown"/>
                    <Button Content="+" Width="24" Command="{Binding IncreaseMaxHarmonicCommand}"/>
                </StackPanel>
            </StackPanel>

        </WrapPanel>

        <!-- No chart message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding LabelNoChart}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>

        <!-- No rows message (e.g. fewer than two factors or no aspects configured) -->
        <TextBlock Grid.Row="2"
                   Text="{Binding LabelNoRows}"
                   Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap"/>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <Border BorderThickness="1" CornerRadius="4" Padding="10" HorizontalAlignment="Left">
                <StackPanel>

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelColHarmonic}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelColAspect}" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelColOrb}" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <Separator Margin="0,0,0,2"/>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding HarmonicText}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Factor1Glyph}" ToolTip="{Binding Factor1Name}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AspectGlyph}" ToolTip="{Binding AspectName}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Factor2Glyph}" ToolTip="{Binding Factor2Name}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding OrbText}" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
