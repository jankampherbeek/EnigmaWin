<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.FixStars.UI.FixStarsInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             DataContext="{Binding Inner}"
             d:DesignWidth="380" d:DesignHeight="300">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
        <StackPanel>

            <!-- Orb section label -->
            <TextBlock Text="{Binding LabelOrbSection}"
                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

            <!-- Orb input row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding LabelOrbLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="40"
                         Text="{Binding OrbDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="°" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox Width="40"
                         Text="{Binding OrbMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="'" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>

            <!-- Calculate button -->
            <Button Content="{Binding LabelCalculate}"
                    Width="120" HorizontalAlignment="Left"
                    Click="OnCalculateClicked"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
