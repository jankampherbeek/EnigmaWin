<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.FixStars.UI.FixStarsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row with factsheet and help buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelTitle}"
                       FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="📄" ToolTip="{Binding TooltipFactsheet}"
                    Margin="0,0,4,0" Click="OnFactsheetClicked"/>
            <Button Grid.Column="2" Content="?" ToolTip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Status / no-data message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>

        <!-- Tabs visible only when there is data -->
        <TabControl Grid.Row="1"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

            <!-- Positions tab -->
            <TabItem Header="{Binding LabelTabPositions}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelColName}"        FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColLongitude}"   FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text=""                              FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelColLatitude}"    FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="{Binding LabelColDeclination}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding PositionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"    FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LongitudeDms}"   FontFamily="Courier New" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LongitudeGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Latitude}"       FontFamily="Courier New" FontSize="11"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Declination}"    FontFamily="Courier New" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Matches tab -->
            <TabItem Header="{Binding LabelTabMatches}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelColName}"   FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColFactor}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColType}"   FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelColOrb}"    FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding MatchRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StarName}"    FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FactorGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding MatchType}"   FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Orb}"         FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
