<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationMidpointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI">
    <Grid>
        <TextBlock Text="{Binding LabelEmpty}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray"/>

        <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="{Binding LabelTitle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button ToolTip="{Binding TooltipFactsheet}" Click="OnFactsheetClicked" Content="📄" Margin="0,0,6,0"/>
                <Button ToolTip="{Binding TooltipHelp}"      Click="OnHelpClicked"      Content="?"         Margin="0,0,6,0"/>
            </StackPanel>

            <!-- Arc canvas -->
            <ui:DeclArcCanvas Grid.Row="1"
                              Items="{Binding ArcItems}"
                              NorthLabel="{Binding LabelNorth}"
                              SouthLabel="{Binding LabelSouth}"
                              Orb="{Binding OrbDeg}"
                              Margin="8,0"/>

            <!-- Matches table -->
            <ListView Grid.Row="2" ItemsSource="{Binding Rows}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding DataContext.LabelF1, RelativeSource={RelativeSource AncestorType=ListView}}" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Glyph1}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelF2, RelativeSource={RelativeSource AncestorType=ListView}}" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Glyph2}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelMidpoint, RelativeSource={RelativeSource AncestorType=ListView}}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MidpointText}"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelOccupant, RelativeSource={RelativeSource AncestorType=ListView}}" Width="55">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OccupantGlyph}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelOccDecl, RelativeSource={RelativeSource AncestorType=ListView}}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OccDeclText}"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelOrb, RelativeSource={RelativeSource AncestorType=ListView}}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OrbText}"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelExactness, RelativeSource={RelativeSource AncestorType=ListView}}" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExactnessText}"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
