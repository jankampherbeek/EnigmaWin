<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:DataType="ui:DeclinationMidpointsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationMidpointsView">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Header: title + help button -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="?"
                        ToolTip.Tip="{Binding TooltipHelp}"
                        Click="OnHelpClicked"/>
            </Grid>
        </Border>

        <!-- Main content area — code-behind switches WideLayout / NarrowLayout visibility -->
        <Grid Grid.Row="1">

            <!-- ═══ WIDE layout: canvas left, table right ═══ -->
            <!-- Cols: Glyph1(22) Glyph2(22) Midpoint(80) sp(16) OccGlyph(22) OccDecl(100) Orb(90) Exact(70) -->
            <Grid x:Name="WideLayout"
                  ColumnDefinitions="380,*"
                  ColumnSpacing="12"
                  IsVisible="False">

                <ui:DeclArcCanvas Grid.Column="0"
                                  Items="{Binding ArcItems}"
                                  NorthLabel="{Binding LabelNorth}"
                                  SouthLabel="{Binding LabelSouth}"
                                  Orb="{Binding OrbDeg}"
                                  VerticalAlignment="Top"/>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding LabelEmpty}"
                                   IsVisible="{Binding HasNoData}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"
                                   Opacity="0.6"
                                   Margin="0,16,0,0"/>
                        <Border IsVisible="{Binding HasData}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="22,22,80,16,22,100,90,70" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding LabelF1}"        FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelF2}"        FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelMidpoint}"  FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LabelOccupant}"  FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding LabelOccDecl}"   FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="6" Text="{Binding LabelOrb}"       FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="7" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Separator Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:DeclinationMidpointsViewModel+MidpointRow">
                                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                                <Grid ColumnDefinitions="22,22,80,16,22,100,90,70" Margin="0,3,0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding Glyph1}"        FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Glyph2}"        FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MidpointText}"  FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding OccupantGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding OccDeclText}"   FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding OrbText}"       FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding ExactnessText}" FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- ═══ NARROW layout: canvas top, table bottom ═══ -->
            <ScrollViewer x:Name="NarrowLayout"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="True">
                <StackPanel Spacing="12">

                    <ui:DeclArcCanvas Items="{Binding ArcItems}"
                                      NorthLabel="{Binding LabelNorth}"
                                      SouthLabel="{Binding LabelSouth}"
                                      Orb="{Binding OrbDeg}"
                                      HorizontalAlignment="Stretch"/>

                    <TextBlock Text="{Binding LabelEmpty}"
                               IsVisible="{Binding HasNoData}"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               Opacity="0.6"/>
                    <Border IsVisible="{Binding HasData}"
                            BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="22,22,80,16,22,100,90,70" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{Binding LabelF1}"        FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelF2}"        FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding LabelMidpoint}"  FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelOccupant}"  FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelOccDecl}"   FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="6" Text="{Binding LabelOrb}"       FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="7" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Separator Margin="0,0,0,2"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:DeclinationMidpointsViewModel+MidpointRow">
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid ColumnDefinitions="22,22,80,16,22,100,90,70" Margin="0,3,0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph1}"        FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph2}"        FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MidpointText}"  FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OccupantGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding OccDeclText}"   FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding OrbText}"       FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding ExactnessText}" FontSize="13" TextAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>

</UserControl>
