<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationLongEquivalentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wheel="clr-namespace:EnigmaWin.Sources.Features.ChartDrawing.UI">
    <Grid>
        <TextBlock Text="{Binding LabelEmpty}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray"/>

        <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="{Binding LabelTitle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{Binding LabelBlackWhite}" Command="{Binding ToggleBlackWhiteCommand}" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelTime}"       Command="{Binding ToggleTimeCommand}"       Margin="0,0,6,0"/>
                <Button Content="{Binding LabelAspects}"    Command="{Binding ToggleAspectsCommand}"    Margin="0,0,6,0"/>
                <Button Content="{Binding LabelDial360}"    Tag="360" Click="OnDialTypeClicked" Margin="0,0,4,0"/>
                <Button Content="{Binding LabelDial90}"     Tag="90"  Click="OnDialTypeClicked" Margin="0,0,4,0"/>
                <Button Content="{Binding LabelDial45}"     Tag="45"  Click="OnDialTypeClicked" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelExport}"     Click="OnExportClicked"                     Margin="0,0,6,0"/>
                <Button ToolTip="{Binding TooltipFactsheet}" Click="OnFactsheetClicked" Content="📄" Margin="0,0,6,0"/>
                <Button ToolTip="{Binding TooltipHelp}"      Click="OnHelpClicked"      Content="?"         Margin="0,0,6,0"/>
            </StackPanel>

            <!-- Wheel area — one canvas per wheel type, switched by visibility -->
            <Grid Grid.Row="1">
                <wheel:ZodiacWheelCanvas
                    PlotData="{Binding PlotData}"
                    Theme="{Binding Theme}"
                    ShowAspects="{Binding ShowAspects}"
                    Visibility="{Binding IsZodiacWheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:HouseWheelCanvas
                    PlotData="{Binding HousePlotData}"
                    Theme="{Binding Theme}"
                    Visibility="{Binding IsHouseWheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:FrenchWheelCanvas
                    PlotData="{Binding PlotData}"
                    Theme="{Binding Theme}"
                    ShowAspects="{Binding ShowAspects}"
                    Visibility="{Binding IsFrenchWheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:RingWheelCanvas
                    PlotData="{Binding PlotData}"
                    Theme="{Binding Theme}"
                    ShowAspects="{Binding ShowAspects}"
                    Visibility="{Binding IsRingWheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:Dial360WheelCanvas
                    PlotData="{Binding DialPlotData}"
                    Theme="{Binding Theme}"
                    Visibility="{Binding IsDial360Wheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:Dial90WheelCanvas
                    PlotData="{Binding Dial90PlotData}"
                    Theme="{Binding Theme}"
                    Visibility="{Binding IsDial90Wheel, Converter={StaticResource BoolToVisibility}}"/>
                <wheel:Dial45WheelCanvas
                    PlotData="{Binding Dial45PlotData}"
                    Theme="{Binding Theme}"
                    Visibility="{Binding IsDial45Wheel, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Table -->
            <ListView Grid.Row="2" ItemsSource="{Binding Rows}" BorderThickness="0" MaxHeight="180">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding DataContext.LabelColFactor, RelativeSource={RelativeSource AncestorType=ListView}}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FactorGlyph}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelColLon, RelativeSource={RelativeSource AncestorType=ListView}}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <TextBlock Text="{Binding LongitudeDms}"/>
                                        <TextBlock Text="{Binding LongitudeSignGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="14" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelColEquiv, RelativeSource={RelativeSource AncestorType=ListView}}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <TextBlock Text="{Binding EquivDms}"/>
                                        <TextBlock Text="{Binding EquivSignGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="14" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
