<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:AllDeclinationsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.AllDeclinationsView"
             SizeChanged="OnSizeChanged">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Top bar: title + action buttons -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsBlackWhite}"
                                  Command="{Binding ToggleBlackWhiteCommand}"
                                  ToolTip.Tip="{Binding LabelBtnBlackWhite}">
                        <Image Source="avares://EnigmaWin/Assets/color.png" Width="16" Height="16"/>
                    </ToggleButton>
                    <Button Content="{Binding LabelBtnExport}"
                            Click="OnExportClicked"/>
                    <Button ToolTip.Tip="{Binding TooltipFactsheet}"
                            Click="OnFactsheetClicked">
                        <Image Source="avares://EnigmaWin/Assets/factsheet.png" Width="16" Height="16"/>
                    </Button>
                    <Button Content="?"
                            ToolTip.Tip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: wide layout = canvas + table side-by-side; narrow = stacked in ScrollViewer -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       IsVisible="{Binding HasNoData}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Wide layout: side-by-side -->
            <Grid x:Name="WideLayout"
                  IsVisible="{Binding HasData}"
                  ColumnDefinitions="Auto,*">

                <!-- Strip canvas (left, constrained width) -->
                <ui:DeclStripCanvas Grid.Column="0"
                                    x:Name="StripCanvasWide"
                                    Items="{Binding StripItems}"
                                    Obliquity="{Binding Obliquity}"
                                    IsBlackWhite="{Binding IsBlackWhite}"
                                    Width="200"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Stretch"/>

                <!-- Declination table (right) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0">

                        <!-- Column headers -->
                        <Grid ColumnDefinitions="32,130,100" Margin="4,0,4,4">
                            <TextBlock Grid.Column="0" Text="{Binding LabelColFactor}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColLongitude}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColDeclination}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,0,0,2"/>

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:AllDeclinationsViewModel+DeclRow">
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="32,130,100" Margin="4,2,4,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FactorGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LongitudeDms}" FontSize="13"/>
                                                <TextBlock Text="{Binding SignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DeclinationDms}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Narrow layout: stacked -->
            <ScrollViewer x:Name="NarrowLayout"
                          IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="0,0,0,8">

                    <!-- Strip canvas -->
                    <ui:DeclStripCanvas x:Name="StripCanvasNarrow"
                                        Items="{Binding StripItems}"
                                        Obliquity="{Binding Obliquity}"
                                        IsBlackWhite="{Binding IsBlackWhite}"
                                        HorizontalAlignment="Stretch"/>

                    <!-- Table -->
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="32,130,100" Margin="4,0,4,4">
                            <TextBlock Grid.Column="0" Text="{Binding LabelColFactor}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColLongitude}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColDeclination}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:AllDeclinationsViewModel+DeclRow">
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="32,130,100" Margin="4,2,4,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FactorGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LongitudeDms}" FontSize="13"/>
                                                <TextBlock Text="{Binding SignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DeclinationDms}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>
