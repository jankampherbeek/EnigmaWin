<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:DeclinationDiagramViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationDiagramView">

    <StackPanel Margin="16" Spacing="12" VerticalAlignment="Top">
        <TextBlock Text="{Binding LabelTitle}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="— placeholder —" FontStyle="Italic" Opacity="0.6"/>
    </StackPanel>

</UserControl>
