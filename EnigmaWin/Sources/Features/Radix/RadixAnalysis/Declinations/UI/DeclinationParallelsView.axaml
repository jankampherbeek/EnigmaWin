<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="ui:DeclinationParallelsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationParallelsView">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Top navigation bar: title + action button -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Content="?"
                            ToolTip.Tip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       IsVisible="{Binding HasNoData}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Data -->
            <ScrollViewer IsVisible="{Binding HasData}">
                <Border BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel Spacing="0">

                        <!-- Column headers -->
                        <!-- Columns: F1 glyph(32) | Decl1(100) | Type glyph(32) | F2 glyph(32) | Decl2(100) | Orb(90) | Exactness(70) -->
                        <Grid ColumnDefinitions="32,100,32,32,100,90,70" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding LabelFactor1}"   FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelDecl1}"     FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelType}"      FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelFactor2}"   FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{Binding LabelDecl2}"     FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{Binding LabelOrb}"       FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,0,0,2"/>

                        <!-- Data rows -->
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:DeclinationParallelsViewModel+ParallelRow">
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="32,100,32,32,100,90,70" Margin="0,3,0,3">

                                            <!-- Factor 1 glyph -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph1}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>

                                            <!-- Declination of factor 1 -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Decl1}"
                                                       FontSize="13"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <!-- Parallel / contra-parallel glyph -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TypeGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <!-- Factor 2 glyph -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Glyph2}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>

                                            <!-- Declination of factor 2 -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Decl2}"
                                                       FontSize="13"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <!-- Orb -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding OrbText}"
                                                       FontSize="13"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <!-- Exactness -->
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding ExactnessText}"
                                                       FontSize="13"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
