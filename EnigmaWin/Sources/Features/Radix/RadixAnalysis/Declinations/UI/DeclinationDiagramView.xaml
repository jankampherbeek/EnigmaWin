<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI.DeclinationDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Declinations.UI">
    <Grid>
        <TextBlock Text="{Binding LabelEmpty}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray"/>

        <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="{Binding LabelTitle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{Binding LabelBtnBlackWhite}"  Command="{Binding ToggleBlackWhiteCommand}"    Margin="0,0,6,0"/>
                <Button Content="{Binding LabelBtnPosLines}"    Command="{Binding TogglePositionLinesCommand}" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelBtnExport}"      Click="OnExportClicked"                        Margin="0,0,6,0"/>
                <Button ToolTip="{Binding TooltipFactsheet}"    Click="OnFactsheetClicked" Content="📄"  Margin="0,0,6,0"/>
                <Button ToolTip="{Binding TooltipHelp}"         Click="OnHelpClicked"      Content="?"         Margin="0,0,6,0"/>
            </StackPanel>

            <!-- Diagram canvas -->
            <ui:DeclDiagramCanvas x:Name="DiagramCanvas"
                                  Grid.Row="1"
                                  Items="{Binding DiagramItems}"
                                  Obliquity="{Binding Obliquity}"
                                  IsBlackWhite="{Binding IsBlackWhite}"
                                  ShowPositionLines="{Binding ShowPositionLines}"
                                  Margin="8,0"/>

            <!-- Table -->
            <ListView Grid.Row="2" ItemsSource="{Binding Rows}" BorderThickness="0" MaxHeight="200">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding DataContext.LabelColFactor,      RelativeSource={RelativeSource AncestorType=ListView}}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FactorGlyph}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelColLongitude,   RelativeSource={RelativeSource AncestorType=ListView}}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <TextBlock Text="{Binding LongitudeDms}"/>
                                        <TextBlock Text="{Binding SignGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="14" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding DataContext.LabelColDeclination, RelativeSource={RelativeSource AncestorType=ListView}}" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeclinationDms}"
                                               Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
