<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.HarmonicOrbs.UI.HarmonicOrbsInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             DataContext="{Binding Inner}"
             d:DesignWidth="380" d:DesignHeight="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
        <StackPanel>

            <!-- Title row with factsheet and help buttons -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LabelTitle}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="📄" ToolTip="{Binding TooltipFactsheet}"
                        Margin="0,0,4,0" Click="OnFactsheetClicked"/>
                <Button Grid.Column="2" Content="?" ToolTip="{Binding TooltipHelp}"
                        Click="OnHelpClicked"/>
            </Grid>

            <!-- No chart message -->
            <TextBlock Text="{Binding LabelNoChart}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                       FontStyle="Italic" Opacity="0.6" Margin="0,0,0,12"/>

            <!-- Maximum orb section -->
            <TextBlock Text="{Binding LabelOrbSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding LabelOrbLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="40"
                         Text="{Binding OrbDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="°" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox Width="40"
                         Text="{Binding OrbMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="'" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>

            <!-- Aspects section -->
            <TextBlock Text="{Binding LabelAspectsSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="{Binding LabelColAspect}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding LabelColEffectiveOrb}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                    <Separator Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding EffectiveOrbText}" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Courier New" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
