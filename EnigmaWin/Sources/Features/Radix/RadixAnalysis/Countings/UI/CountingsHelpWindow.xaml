<Window x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Countings.UI.CountingsHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,8"/>
        <Button Content="{Binding LabelClose}" HorizontalAlignment="Right"
                Margin="0,12,0,0" Padding="20,6" Click="OnCloseClicked"/>
    </StackPanel>
</Window>
