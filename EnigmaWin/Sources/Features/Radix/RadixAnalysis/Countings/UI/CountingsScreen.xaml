<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Countings.UI.CountingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelHeaderTitle}" FontSize="20" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
        </Grid>

        <!-- No chart message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LabelNoChart}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!-- Elements -->
                <TextBlock Text="{Binding LabelElementsTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColCount}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding ElementsCounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding LabelElementsChartTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Name="ElementsPiePanel" Height="200" Background="White"/>
                <WrapPanel Name="ElementsLegendPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                <!-- Crosses -->
                <TextBlock Text="{Binding LabelCrossesTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColCount}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding CrossesCounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding LabelCrossesChartTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Name="CrossesPiePanel" Height="200" Background="White"/>
                <WrapPanel Name="CrossesLegendPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
