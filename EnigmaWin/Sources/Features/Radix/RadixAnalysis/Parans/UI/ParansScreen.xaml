<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Parans.UI.ParansScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row with factsheet and help buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelTitle}"
                       FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="📄" ToolTip="{Binding TooltipFactsheet}"
                    Margin="0,0,4,0" Click="OnFactsheetClicked"/>
            <Button Grid.Column="2" Content="?" ToolTip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Status / no-data message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>

        <!-- Tabs visible only when there is data -->
        <TabControl Grid.Row="1"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

            <!-- Positions tab -->
            <TabItem Header="{Binding LabelTabPositions}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""                                FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColName}"         FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColRising}"       FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelColSetting}"      FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{Binding LabelColCulmination}"  FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{Binding LabelColAntiCulm}"     FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding PositionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="75"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BodyGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BodyName}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Rising}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Setting}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Culmination}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding AntiCulmination}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Matches tab -->
            <TabItem Header="{Binding LabelTabMatches}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text=""                              FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelColBody1}"       FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelColType1}"       FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelColTime}"        FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text=""                              FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="6" Text="{Binding LabelColBody2}"       FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="7" Text="{Binding LabelColType2}"       FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Grid.Column="8" Text="{Binding LabelColTime}"        FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="9" Text="{Binding LabelColOrb}"         FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding MatchRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Body1Glyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Body1Name}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Type1}"   FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time1}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Body2Glyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Body2Name}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="7" Text="{Binding Type2}"   FontSize="12"/>
                                            <TextBlock Grid.Column="8" Text="{Binding Time2}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="9" Text="{Binding Orb}"
                                                       FontFamily="Courier New" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
