<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.VSP.UI.VspScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.VSP.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="24" FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#x1F4C4;" ToolTip="{Binding TooltipFactsheet}"
                        Margin="0,0,4,0" Click="OnFactsheetClicked"/>
                <Button Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
            </StackPanel>
        </Grid>

        <!-- No chart message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LabelNoChart}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>

        <!-- Wheel (full area) -->
        <ui:VspWheelCanvas Grid.Row="1"
                           x:Name="TheWheelCanvas"
                           RadixData="{Binding PlotData}"
                           VspPositions="{Binding VspPositions}"
                           HeadLongitude="{Binding HeadLongitude}"
                           OriginalAscLongitude="{Binding OriginalAscLongitude}"
                           Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
