<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixEdit.UI.RadixEditScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:radixUi="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixInput.UI">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding LabelTitle}" FontSize="24" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Expander x:Name="AboutSection"
                              IsExpanded="True"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelAboutChart}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <radixUi:AboutSectionView/>
                    </Expander>

                    <Expander x:Name="LocationSection"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelLocation}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <radixUi:LocationSectionView/>
                    </Expander>

                    <Expander x:Name="DateTimeSection"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelDateAndTime}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <radixUi:DateTimeSectionView/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked" Margin="0,0,8,0"/>
                <Button Content="{Binding LabelApply}"
                        Click="OnApplyClicked"
                        IsEnabled="{Binding CanCalculate}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
