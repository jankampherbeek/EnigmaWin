<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixInput.UI"
        x:Class="EnigmaWin.Sources.Features.Radix.RadixInput.UI.RadixInputHelpWindow"
        x:DataType="ui:RadixInputHelpWindow"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="16" Margin="20">

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding HeaderAbout}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AboutLine1}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AboutLine2}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding HeaderLocation}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LocationLine1}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LocationLine2}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding HeaderDateTime}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DateTimeLine1}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DateTimeLine2}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DateTimeLine3}" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="{Binding LabelClose}"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Click="OnCloseClicked"/>

    </StackPanel>
</Window>
