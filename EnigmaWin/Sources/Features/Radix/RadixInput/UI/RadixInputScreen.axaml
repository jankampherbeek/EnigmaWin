<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixInput.UI"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="1000"
             x:Name="Root"
             x:DataType="ui:RadixInputViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixInput.UI.RadixInputScreen">

    <Border Padding="20">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,4">
                        <TextBlock Text="{Binding LabelTitle}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Expander x:Name="AboutSection"
                              IsExpanded="True"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelAboutChart}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <ui:AboutSectionView/>
                    </Expander>

                    <Expander x:Name="LocationSection"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelLocation}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <ui:LocationSectionView/>
                    </Expander>

                    <Expander x:Name="DateTimeSection"
                              Expanded="OnSectionExpanded"
                              GotFocus="OnSectionGotFocus"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding LabelDateAndTime}" FontSize="16" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <ui:DateTimeSectionView/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="?" ToolTip.Tip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
                <Button Content="Clear" Click="OnClearClicked"/>
                <Button Content="{Binding LabelCalculate}"
                        Classes="accent"
                        Click="OnCalculateClicked"
                        IsEnabled="{Binding CanCalculate}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
