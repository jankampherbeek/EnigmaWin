<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixOverview.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="500"
             x:DataType="ui:RadixOverviewViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixOverview.UI.RadixOverviewScreen">

    <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="12">

        <!-- Title row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding LabelTitle}"
                       FontSize="24" FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Content="?"
                    ToolTip.Tip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding LabelNewChart}"
                    Classes="accent"
                    Click="OnNewChartClicked"/>
            <Button Content="{Binding LabelSearchChart}"
                    Click="OnSearchChartClicked"/>
        </StackPanel>

        <!-- Session charts group -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid RowDefinitions="Auto,*">

                <TextBlock Grid.Row="0"
                           Text="{Binding LabelSessionGroup}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="1">

                    <!-- Empty state -->
                    <TextBlock Text="{Binding LabelNoCharts}"
                               IsVisible="{Binding HasNoRows}"
                               Opacity="0.7"/>

                    <!-- Charts table -->
                    <ScrollViewer IsVisible="{Binding HasRows}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">

                            <!-- Column headers -->
                            <Border BorderThickness="0,0,0,1" Padding="4,0,4,6">
                                <Grid ColumnDefinitions="240,120,80,80">
                                    <TextBlock Grid.Column="0" Text="{Binding LabelColName}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelColJulianDay}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text=""
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text=""
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Chart rows -->
                            <ItemsControl ItemsSource="{Binding SessionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:SessionChartRow">
                                        <Grid ColumnDefinitions="240,120,80,80" Margin="0,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayJulianDay}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding LabelSelect}"
                                                    Click="OnSelectClicked"
                                                    Margin="2,1"
                                                    Classes="accent"/>
                                            <Button Grid.Column="3"
                                                    Content="{Binding LabelEdit}"
                                                    Click="OnEditClicked"
                                                    Margin="2,1"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
