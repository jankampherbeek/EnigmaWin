<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixOverview.UI.RadixOverviewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixOverview.UI">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="24" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="?" ToolTip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{Binding LabelNewChart}"    Click="OnNewChartClicked"    Margin="0,0,8,0"/>
            <Button Content="{Binding LabelSearchChart}" Click="OnSearchChartClicked"/>
        </StackPanel>

        <!-- Session charts group -->
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding LabelSessionGroup}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding LabelNoCharts}"
                               Opacity="0.7"
                               Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}"/>

                    <ScrollViewer Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderThickness="0,0,0,1" Padding="4,0,4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LabelColName}"      FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelColJulianDay}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SessionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SessionChartRow}">
                                        <Grid Margin="0,2" Cursor="Hand" Background="Transparent"
                                              MouseLeftButtonUp="OnRowClicked">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding LabelEdit}"
                                                              Tag="{Binding}"
                                                              Click="OnEditMenuClicked"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,4,4,4">
                                                <TextBlock Text="✓ " Foreground="CornflowerBlue"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayJulianDay}"
                                                       VerticalAlignment="Center" Margin="4,4"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
