<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixPositions.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:DataType="ui:RadixPositionsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixPositions.UI.RadixPositionsScreen">

    <Grid RowDefinitions="Auto,*" Margin="8">
        <TextBlock Grid.Row="0" Text="Radix Positions" FontSize="24" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasData}">
            <StackPanel Spacing="14" Margin="0,14,0,0">
            <Border BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Planets" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="110,100,100,120,120,100,100,100">
                        <TextBlock Grid.Column="0" Text="Planet" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Longitude" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Latitude" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Right Ascension" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Declination" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Distance" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Azimuth" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="Altitude" FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PlanetRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="110,100,100,120,120,100,100,100">
                                    <TextBlock Grid.Column="0" Text="{Binding Planet}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Longitude}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Latitude}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RightAscension}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Declination}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Distance}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Azimuth}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Altitude}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Cusps" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="110,120,120,120,100,100">
                        <TextBlock Grid.Column="0" Text="Cusp" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Longitude" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Right Ascension" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Declination" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Azimuth" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Altitude" FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CuspRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="110,120,120,120,100,100">
                                    <TextBlock Grid.Column="0" Text="{Binding Cusp}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Longitude}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RightAscension}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Declination}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Azimuth}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Altitude}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   Text="Geen positiegegevens beschikbaar voor deze chart."
                   IsVisible="{Binding HasNoData}"/>
    </Grid>
</UserControl>
