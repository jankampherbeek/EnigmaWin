<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Radix.RadixPositions.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:DataType="ui:RadixPositionsViewModel"
             x:Class="EnigmaWin.Sources.Features.Radix.RadixPositions.UI.RadixPositionsScreen">

    <Grid RowDefinitions="Auto,*" Margin="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Radix Positions" FontSize="24" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="?" ToolTip.Tip="{Binding TooltipHelp}" Click="OnHelpClicked"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasData}">
            <StackPanel Spacing="14" Margin="0,14,0,0">

                <!-- Planets table — wide layout -->
                <Border BorderThickness="1" CornerRadius="8" Padding="10"
                        IsVisible="{Binding IsWideLayout}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="50,130,100,120,120,100,100,100">
                            <TextBlock Grid.Column="0" Text=""                              FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelLength}"         FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelLatitude}"       FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelRightAscension}" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{Binding LabelDeclination}"    FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{Binding LabelDistance}"       FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="{Binding LabelAzimuth}"        FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="{Binding LabelAltitude}"       FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PlanetRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="50,130,100,120,120,100,100,100">
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18" TextAlignment="Right"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LongitudeDms}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding LongitudeSignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Latitude}"       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RightAscension}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Declination}"    TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Distance}"       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Azimuth}"        TextAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Text="{Binding Altitude}"       TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Planets table — compact layout -->
                <Border BorderThickness="1" CornerRadius="8" Padding="10"
                        IsVisible="{Binding IsNarrowLayout}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="50,130,120">
                            <TextBlock Grid.Column="0" Text=""                           FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelLength}"      FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelDeclination}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PlanetRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="50,130,120">
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18" TextAlignment="Right"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LongitudeDms}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding LongitudeSignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Declination}" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cusps table — wide layout -->
                <Border BorderThickness="1" CornerRadius="8" Padding="10"
                        IsVisible="{Binding IsWideLayout}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="50,130,120,120,100,100">
                            <TextBlock Grid.Column="0" Text="{Binding LabelCusp}"           FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelLength}"         FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelRightAscension}" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding LabelDeclination}"    FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{Binding LabelAzimuth}"        FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{Binding LabelAltitude}"       FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CuspRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="50,130,120,120,100,100">
                                            <TextBlock Grid.Column="0" Text="{Binding Cusp}"           TextAlignment="Right"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LongitudeDms}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding LongitudeSignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding RightAscension}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Declination}"    TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Azimuth}"        TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Altitude}"       TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cusps table — compact layout -->
                <Border BorderThickness="1" CornerRadius="8" Padding="10"
                        IsVisible="{Binding IsNarrowLayout}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="50,130,120">
                            <TextBlock Grid.Column="0" Text="{Binding LabelCusp}"        FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelLength}"      FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelDeclination}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CuspRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid ColumnDefinitions="50,130,120">
                                            <TextBlock Grid.Column="0" Text="{Binding Cusp}"        TextAlignment="Right"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LongitudeDms}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding LongitudeSignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Declination}" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   Text="{Binding LabelEmpty}"
                   IsVisible="{Binding HasNoData}"/>
    </Grid>
</UserControl>
