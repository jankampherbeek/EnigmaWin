<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigEditScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button Content="{Binding LabelCancel}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnCancelClicked" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelSave}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnSaveClicked" Margin="0,0,6,0"/>
                <Button Content="?" ToolTip="{Binding LabelHelpTooltip}"
                        Click="OnHelpClicked"/>
            </StackPanel>
            <TextBlock Text="{Binding ConfigTitle}" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Name field -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelName}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Section navigation -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSettings}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <Button Content="{Binding LabelCalcSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnCalcClicked"/>
                        <Button Content="{Binding LabelDisplaySection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnDisplayClicked"/>
                        <Button Content="{Binding LabelGlyphsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnGlyphsClicked"/>
                        <Button Content="{Binding LabelFactorsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnFactorsClicked"/>
                        <Button Content="{Binding LabelAspectsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnAspectsClicked"/>
                        <Button Content="{Binding LabelOrbsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnOrbsClicked"/>
                        <Button Content="{Binding LabelProgressionsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Margin="0,0,0,2" Click="OnProgressionsClicked"/>
                        <Button Content="{Binding LabelFixStarsSection}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" Click="OnFixStarsClicked"/>
                    </StackPanel>
                </Border>

                <!-- Active configuration -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LabelActiveToggle}"
                                       FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="16"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="{Binding LabelSetActive}"
                                        Click="OnSetActiveClicked">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding LabelActiveFooter}"
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
