<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigEditScreen"
             x:DataType="ui:ConfigEditViewModel"
             d:DesignWidth="500"
             d:DesignHeight="600"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Header: buttons row, then title -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Content="{Binding LabelCancel}"
                        IsVisible="{Binding IsDirty}"
                        Click="OnCancelClicked"/>
                <Button Content="{Binding LabelSave}"
                        Classes="accent"
                        IsVisible="{Binding IsDirty}"
                        Click="OnSaveClicked"/>
                <Button Content="?"
                        ToolTip.Tip="{Binding LabelHelpTooltip}"
                        Click="OnHelpClicked"/>
            </StackPanel>
            <TextBlock Text="{Binding ConfigTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Name field -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding LabelName}"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Section navigation -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding LabelSettings}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"/>
                        <Button Content="{Binding LabelCalcSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnCalcClicked"/>
                        <Button Content="{Binding LabelDisplaySection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnDisplayClicked"/>
                        <Button Content="{Binding LabelGlyphsSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnGlyphsClicked"/>
                        <Button Content="{Binding LabelFactorsSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnFactorsClicked"/>
                        <Button Content="{Binding LabelAspectsSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnAspectsClicked"/>
                        <Button Content="{Binding LabelOrbsSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnOrbsClicked"/>
                        <Button Content="{Binding LabelProgressionsSection}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Click="OnProgressionsClicked"/>
                    </StackPanel>
                </Border>

                <!-- Active configuration -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LabelActiveToggle}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="✓"
                                           FontSize="16"
                                           IsVisible="{Binding IsActive}"
                                           VerticalAlignment="Center"/>
                                <Button Content="{Binding LabelSetActive}"
                                        Classes="accent"
                                        IsVisible="{Binding !IsActive}"
                                        Click="OnSetActiveClicked"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding LabelActiveFooter}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
