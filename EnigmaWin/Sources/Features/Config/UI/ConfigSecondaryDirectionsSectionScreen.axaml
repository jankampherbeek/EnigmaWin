<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigSecondaryDirectionsSectionScreen"
             x:DataType="ui:ConfigSecondaryDirectionsSectionViewModel"
             d:DesignWidth="500"
             d:DesignHeight="560"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Header: buttons row, then title -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Content="{Binding LabelBackToOverview}"
                        Click="OnBackClicked"/>
                <Button Grid.Column="2"
                        Content="{Binding LabelCancel}"
                        IsVisible="{Binding IsDirty}"
                        Click="OnCancelClicked"/>
                <Button Grid.Column="3"
                        Content="{Binding LabelSave}"
                        Classes="accent"
                        IsVisible="{Binding IsDirty}"
                        Click="OnSaveClicked"/>
                <Button Grid.Column="4"
                        Content="?"
                        ToolTip.Tip="{Binding LabelHelpTooltip}"
                        Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Orb section -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LabelSectionOrb}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LabelOrb}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal" Spacing="4">
                                <NumericUpDown Value="{Binding OrbDeg, Mode=TwoWay}"
                                               Minimum="0" Maximum="10" Increment="1"
                                               Width="120"/>
                                <TextBlock Text="°" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding OrbMin, Mode=TwoWay}"
                                               Minimum="0" Maximum="59" Increment="1"
                                               Width="120"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Factors section -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LabelSectionFactors}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Margin="0,0,0,4"/>

                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FactorRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="ui:TransitsFactorRowViewModel">
                                        <Grid ColumnDefinitions="28,*,50,16" Margin="4,1">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FactorName}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox  Grid.Column="2"
                                                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
