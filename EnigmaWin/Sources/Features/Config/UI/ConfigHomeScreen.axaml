<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigHomeScreen"
             x:DataType="ui:ConfigHomeViewModel"
             d:DesignWidth="700"
             d:DesignHeight="500"
             mc:Ignorable="d">
    <StackPanel Spacing="12" Margin="8">
        <TextBlock Text="Configuration" FontSize="24" FontWeight="SemiBold"/>
        <Border BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ConfigName}" FontSize="16" FontWeight="SemiBold"/>
                    <Border CornerRadius="4" Padding="6,2" IsVisible="{Binding IsActive}"
                            Background="{DynamicResource SystemAccentColor}">
                        <TextBlock Text="Active" Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Opacity="0.85"/>
                <TextBlock Text="Section editors will be added in the next step." Opacity="0.6" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
