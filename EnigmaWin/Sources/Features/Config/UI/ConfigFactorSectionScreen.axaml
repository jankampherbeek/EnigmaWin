<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigFactorSectionScreen"
             x:DataType="ui:ConfigFactorSectionViewModel"
             d:DesignWidth="500"
             d:DesignHeight="700"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Margin="8">

        <!-- Header: buttons row, then title -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Content="{Binding LabelBackToOverview}"
                        Click="OnBackClicked"/>
                <Button Grid.Column="2"
                        Content="{Binding LabelRestoreDefaults}"
                        Click="OnRestoreDefaultsClicked"/>
                <Button Grid.Column="3"
                        Content="{Binding LabelCancel}"
                        IsVisible="{Binding IsDirty}"
                        Click="OnCancelClicked"/>
                <Button Grid.Column="4"
                        Content="{Binding LabelSave}"
                        Classes="accent"
                        IsVisible="{Binding IsDirty}"
                        Click="OnSaveClicked"/>
                <Button Grid.Column="5"
                        Content="?"
                        ToolTip.Tip="{Binding LabelHelpTooltip}"
                        Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Column headers -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*,75,75,120,16" Margin="4,0">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="{Binding LabelColUsed}"
                           FontWeight="SemiBold" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding LabelColDrawn}"
                           FontWeight="SemiBold" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding LabelColOrb}"
                           FontWeight="SemiBold" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scrollable factor list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FactorRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ui:FactorRowViewModel">
                        <Grid ColumnDefinitions="*,75,75,120,16"
                              Margin="4,1">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FactorName}"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsUsed, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding IsDrawn, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="3"
                                          Value="{Binding OrbPercentage, Mode=TwoWay}"
                                          Minimum="0"
                                          Maximum="100"
                                          Increment="1"
                                          HorizontalAlignment="Stretch"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
