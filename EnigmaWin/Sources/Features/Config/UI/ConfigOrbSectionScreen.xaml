<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigOrbSectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="{Binding LabelCancel}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnCancelClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Content="{Binding LabelSave}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnSaveClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Content="?" ToolTip="{Binding LabelHelpTooltip}" Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Orb system -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionSystem}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelOrbSystem}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0"
                                      ItemsSource="{Binding OrbSystemNames}"
                                      SelectedIndex="{Binding SelectedOrbSystemIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Orb values -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionValues}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelAspectBase}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding AspectBaseDeg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding AspectBaseMin, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelMidpoint360}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Midpoint360Deg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Midpoint360Min, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelMidpoint90}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Midpoint90Deg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Midpoint90Min, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelMidpoint45}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Midpoint45Deg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Midpoint45Min, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelHarmonic}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding HarmonicDeg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding HarmonicMin, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelParallel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding ParallelDeg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ParallelMin, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelDeclinationMidpoint}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding DeclinationMidpointDeg, Mode=TwoWay}" Width="60" Margin="8,0,4,0"/>
                                <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DeclinationMidpointMin, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                                <TextBlock Text="'" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
