<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigCalcSectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="{Binding LabelCancel}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnCancelClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Content="{Binding LabelSave}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnSaveClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Content="?" ToolTip="{Binding LabelHelpTooltip}" Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Coordinate Systems -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionSystems}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelHouseSystem}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding HouseSystemNames}"
                                      SelectedIndex="{Binding SelectedHouseSystemIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelAyanamsha}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding AyanamshaNames}"
                                      SelectedIndex="{Binding SelectedAyanamshaIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Calculation -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionCalc}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelObserverPosition}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding ObserverPositionNames}"
                                      SelectedIndex="{Binding SelectedObserverPositionIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelProjectionType}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding ProjectionTypeNames}"
                                      SelectedIndex="{Binding SelectedProjectionTypeIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Lunar Factors -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionLunar}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelBlackMoon}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding BlackMoonNames}"
                                      SelectedIndex="{Binding SelectedBlackMoonCorrectionIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelLunarNode}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding LunarNodeNames}"
                                      SelectedIndex="{Binding SelectedLunarNodeIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelLotsType}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding LotsTypeNames}"
                                      SelectedIndex="{Binding SelectedLotsTypeIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Speed Thresholds -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionSpeeds}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                        <!-- Stationary -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelStationary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StationaryPercentage, StringFormat='{}{0:F0}%'}"
                                           Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="50" TickFrequency="1"                                    Value="{Binding StationaryPercentage, Mode=TwoWay}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding LabelStationaryFooter}" Opacity="0.6" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>

                        <!-- Slow -->
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelSlow}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SlowPercentage, StringFormat='{}{0:F0}%'}"
                                           Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="99" TickFrequency="1"                                    Value="{Binding SlowPercentage, Mode=TwoWay}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding LabelSlowFooter}" Opacity="0.6" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
