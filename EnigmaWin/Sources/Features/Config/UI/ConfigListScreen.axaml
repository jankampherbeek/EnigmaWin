<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             xmlns:cfg="using:EnigmaWin.Sources.Features.Config"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigListScreen"
             x:DataType="ui:ConfigListViewModel"
             d:DesignWidth="300"
             d:DesignHeight="600"
             mc:Ignorable="d">

    <Grid>
        <!-- Main content -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="8">

            <!-- Title + Add button -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                <Button Content="{Binding LabelAdd}"
                        HorizontalAlignment="Right"
                        Click="OnAddClicked"/>
                <TextBlock Text="{Binding LabelTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Config list -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Configurations}"
                     SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="cfg:UserConfiguration">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">

                            <!-- Name + active badge -->
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                <TextBlock FontSize="11"
                                           Opacity="0.65"
                                           IsVisible="{Binding IsActive}">
                                    <Run Text="● "/>
                                    <Run Text="Active"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Active checkmark -->
                            <TextBlock Grid.Column="1"
                                       Text="✓"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="6,0"
                                       IsVisible="{Binding IsActive}"/>

                            <!-- Delete button -->
                            <Button Grid.Column="2"
                                    Content="✕"
                                    FontSize="12"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Click="OnDeleteClicked"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel Grid.Row="2"
                        Margin="0,12,0,0"
                        Spacing="4"
                        IsVisible="{Binding !Configurations.Count}">
                <TextBlock Text="{Binding LabelEmptyTitle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LabelEmptyDesc}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Add config overlay panel -->
        <Border IsVisible="{Binding IsAddPanelVisible}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="8"
                VerticalAlignment="Top">
            <StackPanel Spacing="12">

                <TextBlock Text="{Binding LabelNewTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <!-- Name field -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LabelNewName}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NewConfigName, Mode=TwoWay}"
                             Watermark="{Binding LabelNewNamePlaceholder}"
                             x:Name="NewNameBox"/>
                </StackPanel>

                <!-- Based on -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LabelNewBasedOn}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Configurations}"
                              SelectedItem="{Binding BasedOnConfig, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="cfg:UserConfiguration">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LabelNewBasedOnFooter}"
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               FontSize="11"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="{Binding LabelCancel}"
                            Click="OnCancelAddClicked"/>
                    <Button Content="{Binding LabelNewCreate}"
                            Classes="accent"
                            Click="OnConfirmAddClicked"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
