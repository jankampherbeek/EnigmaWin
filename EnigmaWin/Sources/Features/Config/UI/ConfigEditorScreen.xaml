<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigEditorScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Config.UI">

    <StackPanel Margin="8">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="House system" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding HouseSystemValues}"
                      SelectedItem="{Binding HouseSystem, Mode=TwoWay}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ayanamsha" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding AyanamshaValues}"
                      SelectedItem="{Binding Ayanamsha, Mode=TwoWay}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Observer position" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding ObserverPositionValues}"
                      SelectedItem="{Binding ObserverPosition, Mode=TwoWay}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Projection type" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding ProjectionTypeValues}"
                      SelectedItem="{Binding ProjectionType, Mode=TwoWay}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Black moon correction" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding BlackMoonCorrectionTypeValues}"
                      SelectedItem="{Binding BlackMoonCorrectionType, Mode=TwoWay}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Lunar node type" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding LunarNodeTypeValues}"
                      SelectedItem="{Binding LunarNodeType, Mode=TwoWay}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Lots type" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding LotsTypeValues}"
                      SelectedItem="{Binding LotsType, Mode=TwoWay}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Language" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="8,4,0,4"
                      ItemsSource="{Binding LanguageValues}"
                      SelectedItem="{Binding Language, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:LanguageOption}">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
