<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigGlyphsSectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Config.UI">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="{Binding LabelRestoreDefaults}" Click="OnRestoreDefaultsClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Content="{Binding LabelCancel}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnCancelClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Content="{Binding LabelSave}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnSaveClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="5" Content="?" ToolTip="{Binding LabelHelpTooltip}" Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Signs section -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSignChoices}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionSigns}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SignRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:GlyphRowViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ItemName}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:GlyphCandidateViewModel}">
                                                    <Button Command="{Binding SelectCommand}" Padding="4" Margin="2">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#4000A0FF"/>
                                                                        <Setter Property="BorderBrush" Value="#007AFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="{StaticResource GlyphFont}"
                                                                   FontSize="22" Width="28"
                                                                   TextAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Factors section -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFactorChoices}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionFactors}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding FactorRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:GlyphRowViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ItemName}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:GlyphCandidateViewModel}">
                                                    <Button Command="{Binding SelectCommand}" Padding="4" Margin="2">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#4000A0FF"/>
                                                                        <Setter Property="BorderBrush" Value="#007AFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="{StaticResource GlyphFont}"
                                                                   FontSize="22" Width="28"
                                                                   TextAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Aspects section -->
                <Border BorderThickness="1" CornerRadius="8" Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAspectChoices}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding LabelSectionAspects}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding AspectRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:GlyphRowViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ItemName}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:GlyphCandidateViewModel}">
                                                    <Button Command="{Binding SelectCommand}" Padding="4" Margin="2">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#4000A0FF"/>
                                                                        <Setter Property="BorderBrush" Value="#007AFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="{StaticResource GlyphFont}"
                                                                   FontSize="22" Width="28"
                                                                   TextAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
