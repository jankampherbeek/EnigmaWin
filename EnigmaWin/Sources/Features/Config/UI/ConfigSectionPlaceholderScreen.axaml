<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:EnigmaWin.Sources.Features.Config.UI"
             x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigSectionPlaceholderScreen"
             x:DataType="ui:ConfigSectionViewModel"
             d:DesignWidth="500"
             d:DesignHeight="400"
             mc:Ignorable="d">

    <StackPanel Spacing="12" Margin="8">

        <!-- Header: buttons row, then title -->
        <StackPanel Spacing="4">
            <Button Content="{Binding LabelBackToOverview}"
                    Click="OnBackClicked"/>
            <TextBlock Text="{Binding SectionTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <Border BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Config.Name}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Opacity="0.75"/>
                <TextBlock Text="This section editor will be implemented in the next step."
                           Opacity="0.6"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
