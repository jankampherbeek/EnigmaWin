<UserControl x:Class="EnigmaWin.Sources.Features.Synastry.UI.SynastryCompareScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:progressive="clr-namespace:EnigmaWin.Sources.Features.Progressive.DualWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LabelInnerLabel}" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InnerChartName}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding LabelOuterLabel}" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OuterChartName}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="{Binding LabelSwap}" Command="{Binding SwapCommand}" Margin="2,0"/>
                    <Button Content="{Binding LabelWheelBlackWhite}" Command="{Binding ToggleBlackWhiteCommand}" Margin="8,0,2,0"/>
                    <Button Content="{Binding LabelWheelAspects}" Command="{Binding ToggleAspectsCommand}" Margin="2,0"/>
                    <Button Content="{Binding LabelWheelExport}" Click="OnExportClicked" Margin="2,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked"/>
            </Grid>
        </Border>

        <!-- No-selection placeholder -->
        <TextBlock Grid.Row="1" Text="{Binding LabelTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTwoCharts}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Bi-wheel -->
        <progressive:DualWheelCanvas Grid.Row="1"
            RadixData="{Binding RadixPlotData}"
            TransitItems="{Binding OuterPlotItems}"
            Theme="{Binding Theme}"
            ShowAspects="{Binding ShowAspects}"
            Visibility="{Binding HasTwoCharts, Converter={StaticResource BoolToVisibility}}"/>

    </Grid>
</UserControl>
