<UserControl x:Class="EnigmaWin.Sources.Features.Synastry.UI.SynastryAspectComparisonScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Synastry.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding LabelExportPdf}" Click="OnExportPdfClicked" Margin="2,0"
                            Visibility="{Binding HasAspects, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- No-selection / no-aspects placeholders -->
                <TextBlock Text="{Binding LabelNoAspects}" Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasTwoCharts}" Value="True"/>
                                        <Condition Binding="{Binding HasAspects}"   Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Two directional tables -->
                <Grid Visibility="{Binding HasAspects, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Table: from A's perspective -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ChartAName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="3" Text="{Binding LabelColOrb}"
                                           FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding RowsFromA}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:SynastryAspectRow}">
                                    <Grid Margin="0,1" Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RadixGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AspectGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PartnerGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="3" Text="{Binding OrbText}"
                                                   HorizontalAlignment="Right" Margin="4" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Table: from B's perspective -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding ChartBName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="3" Text="{Binding LabelColOrb}"
                                           FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding RowsFromB}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:SynastryAspectRow}">
                                    <Grid Margin="0,1" Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RadixGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AspectGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PartnerGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18" HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="3" Text="{Binding OrbText}"
                                                   HorizontalAlignment="Right" Margin="4" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
