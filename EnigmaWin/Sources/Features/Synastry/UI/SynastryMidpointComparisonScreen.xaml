<UserControl x:Class="EnigmaWin.Sources.Features.Synastry.UI.SynastryMidpointComparisonScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Synastry.UI"
             xmlns:midpointsUi="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding LabelTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Content="{Binding LabelDial360}" GroupName="SynastryDial" Margin="0,0,12,0" VerticalAlignment="Center"
                                 IsChecked="{Binding DialType, Converter={StaticResource EnumEqualsDialZero}, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding LabelDial90}" GroupName="SynastryDial" Margin="0,0,12,0" VerticalAlignment="Center"
                                 IsChecked="{Binding DialType, Converter={StaticResource EnumEqualsDialOne}, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding LabelDial45}" GroupName="SynastryDial" VerticalAlignment="Center"
                                 IsChecked="{Binding DialType, Converter={StaticResource EnumEqualsDialTwo}, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding LabelExportPdf}" Click="OnExportPdfClicked" Margin="2,0"/>
                    <Button Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- Chart A section -->
                <TextBlock Text="{Binding ChartAName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding LabelNoMatches}" Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMatchesA}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding HasMatchesA, Converter={StaticResource BoolToVisibility}}">
                    <midpointsUi:MidpointTreePanelControl Matches="{Binding MatchesA}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelColPartner1}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelColPartner2}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelColRadix}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelColOrb}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelColExactness}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,0,0,2"/>
                            <ItemsControl ItemsSource="{Binding RowsA}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SynastryMidpointRow}">
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph1}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph2}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                    <TextBlock Text="{Binding MidpointSignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" Margin="2,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding PartnerGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OrbText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ExactnessText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Chart B section -->
                <TextBlock Text="{Binding ChartBName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding LabelNoMatches}" Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMatchesB}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding HasMatchesB, Converter={StaticResource BoolToVisibility}}">
                    <midpointsUi:MidpointTreePanelControl Matches="{Binding MatchesB}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Border BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelColPartner1}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelColPartner2}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelColRadix}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelColOrb}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelColExactness}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,0,0,2"/>
                            <ItemsControl ItemsSource="{Binding RowsB}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SynastryMidpointRow}">
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph1}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph2}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                    <TextBlock Text="{Binding MidpointSignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" Margin="2,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding PartnerGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OrbText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ExactnessText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
