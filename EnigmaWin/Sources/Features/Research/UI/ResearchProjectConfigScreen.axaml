<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Research.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="800"
             x:DataType="ui:ResearchProjectConfigViewModel"
             x:Class="EnigmaWin.Sources.Features.Research.UI.ResearchProjectConfigScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              Margin="8" RowSpacing="12">

            <!-- Title + help button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="?"
                        VerticalAlignment="Top"
                        ToolTip.Tip="{Binding TooltipHelp}"
                        Click="OnHelpClicked"/>
            </Grid>

            <!-- House system section (FactorsInHouses only) -->
            <Border Grid.Row="1"
                    IsVisible="{Binding ShowHouseSystem}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionHouse}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding HouseSystemItems}"
                              SelectedItem="{Binding SelectedHouseSystemItem}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Aspect orb section (Aspects only) -->
            <Border Grid.Row="2"
                    IsVisible="{Binding ShowAspectOrb}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionOrb}" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.6">
                        <Run Text="{Binding LabelOrbFromConfig}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding OrbFromConfigAspect}"/>
                    </TextBlock>
                    <CheckBox Content="{Binding LabelOrbOverride}"
                              IsChecked="{Binding OverrideAspectOrb}"/>
                    <StackPanel IsVisible="{Binding OverrideAspectOrb}" Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding AspectOrbDeg}" Minimum="0" Maximum="30"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding AspectOrbMin}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Aspects selection (Aspects only) -->
            <Border Grid.Row="3"
                    IsVisible="{Binding ShowAspects}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LabelSectionAspects}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding AspectItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:AspectItem">
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unaspect orb section (Unaspect only) -->
            <Border Grid.Row="4"
                    IsVisible="{Binding ShowUnaspectOrb}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionOrb}" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.6">
                        <Run Text="{Binding LabelOrbFromConfig}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding OrbFromConfigUnaspect}"/>
                    </TextBlock>
                    <CheckBox Content="{Binding LabelOrbOverride}"
                              IsChecked="{Binding OverrideUnaspectOrb}"/>
                    <StackPanel IsVisible="{Binding OverrideUnaspectOrb}" Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding UnaspectOrbDeg}" Minimum="0" Maximum="30"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding UnaspectOrbMin}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dial type section (Midpoints only) -->
            <Border Grid.Row="5"
                    IsVisible="{Binding ShowDials}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LabelSectionDial}" FontWeight="SemiBold"/>
                    <CheckBox Content="{Binding LabelDial360}" IsChecked="{Binding UseDial360}"/>
                    <CheckBox Content="{Binding LabelDial90}"  IsChecked="{Binding UseDial90}"/>
                    <CheckBox Content="{Binding LabelDial45}"  IsChecked="{Binding UseDial45}"/>
                </StackPanel>
            </Border>

            <!-- Midpoint orbs per dial (Midpoints only) -->
            <Border Grid.Row="6"
                    IsVisible="{Binding ShowMidpointOrbs}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LabelSectionOrb}" FontWeight="SemiBold"/>
                    <!-- 360 dial orb -->
                    <StackPanel IsVisible="{Binding UseDial360}" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelDial360}" Width="60" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint360Deg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint360Min}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 90 dial orb -->
                    <StackPanel IsVisible="{Binding UseDial90}" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelDial90}" Width="60" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint90Deg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint90Min}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 45 dial orb -->
                    <StackPanel IsVisible="{Binding UseDial45}" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelDial45}" Width="60" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint45Deg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding OrbMidpoint45Min}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Harmonic number section (Harmonics only) -->
            <Border Grid.Row="7"
                    IsVisible="{Binding ShowHarmonicNum}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionHarmon}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelHarmonicNumber}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding HarmonicNumberText}" Width="80"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HarmonicNumberError}"
                               Foreground="Red"
                               IsVisible="{Binding HasHarmonicNumberError}"
                               TextWrapping="Wrap"/>
                    <!-- Harmonic orb override -->
                    <TextBlock Opacity="0.6">
                        <Run Text="{Binding LabelOrbFromConfig}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding OrbFromConfigHarmonic}"/>
                    </TextBlock>
                    <CheckBox Content="{Binding LabelOrbOverride}"
                              IsChecked="{Binding OverrideHarmonicOrb}"/>
                    <StackPanel IsVisible="{Binding OverrideHarmonicOrb}" Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding HarmonicOrbDeg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding HarmonicOrbMin}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Parallels orb section (Parallels only) -->
            <Border Grid.Row="8"
                    IsVisible="{Binding ShowParallelOrb}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionOrb}" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.6">
                        <Run Text="{Binding LabelOrbFromConfig}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding OrbFromConfigParallel}"/>
                    </TextBlock>
                    <CheckBox Content="{Binding LabelOrbOverride}"
                              IsChecked="{Binding OverrideParallelOrb}"/>
                    <StackPanel IsVisible="{Binding OverrideParallelOrb}" Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding ParallelOrbDeg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding ParallelOrbMin}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DeclMidpoints orb section (DeclMidpoints only) -->
            <Border Grid.Row="9"
                    IsVisible="{Binding ShowDeclMidOrb}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelSectionOrb}" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.6">
                        <Run Text="{Binding LabelOrbFromConfig}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding OrbFromConfigDeclMid}"/>
                    </TextBlock>
                    <CheckBox Content="{Binding LabelOrbOverride}"
                              IsChecked="{Binding OverrideDeclMidpointOrb}"/>
                    <StackPanel IsVisible="{Binding OverrideDeclMidpointOrb}" Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding DeclMidpointOrbDeg}" Minimum="0" Maximum="10"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="°" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding DeclMidpointOrbMin}" Minimum="0" Maximum="59"
                                       FormatString="0" Width="120" Increment="1"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Factors section (always shown) -->
            <Border Grid.Row="10"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LabelSectionFactors}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding FactorItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:FactorItem">
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected}"
                                          Click="OnFactorToggled"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Error message -->
            <TextBlock Grid.Row="11"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       IsVisible="{Binding HasError}"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid Grid.Row="12" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Content="{Binding LabelCancel}"
                        Click="OnCancelClicked"/>
                <Button Grid.Column="2"
                        Content="{Binding LabelSave}"
                        Classes="accent"
                        IsEnabled="{Binding CanSave}"
                        Click="OnSaveClicked"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
