<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Research.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="600"
             x:DataType="ui:ResearchProjectsListViewModel"
             x:Class="EnigmaWin.Sources.Features.Research.UI.ResearchProjectsListScreen">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="12">

        <!-- Title + help -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding LabelTitle}"
                       FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="?"
                    VerticalAlignment="Top"
                    ToolTip.Tip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Search bar (search mode only) -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsSearchMode}"
                    Orientation="Horizontal" Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding LabelSearchLabel}"
                           Opacity="0.7" FontSize="12"/>
                <TextBox Text="{Binding SearchQuery}"
                         MinWidth="240"
                         KeyDown="OnSearchKeyDown"/>
            </StackPanel>
            <Button Content="{Binding LabelSearchBtn}"
                    Classes="accent"
                    IsEnabled="{Binding CanSearch}"
                    VerticalAlignment="Bottom"
                    Click="OnSearchClicked"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap"/>

        <!-- No results message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding NoResultsMessage}"
                   Opacity="0.6"
                   IsVisible="{Binding HasNoResults}"/>

        <!-- Project table -->
        <Border Grid.Row="4" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Header row -->
                    <Grid ColumnDefinitions="200,280,160,80,80"
                          Margin="8,6" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LabelColumnName}"
                                   FontWeight="SemiBold" Opacity="0.7" FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LabelColumnDesc}"
                                   FontWeight="SemiBold" Opacity="0.7" FontSize="12"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LabelColumnDate}"
                                   FontWeight="SemiBold" Opacity="0.7" FontSize="12"/>
                    </Grid>

                    <Border BorderThickness="0,1,0,0" Opacity="0.3"/>

                    <!-- Data rows -->
                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:ProjectListItem">
                                <Grid ColumnDefinitions="200,280,160,80,80"
                                      Margin="8,6" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               VerticalAlignment="Center"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedDate}"
                                               VerticalAlignment="Center"
                                               Opacity="0.7"/>
                                    <Button Grid.Column="3"
                                            Content="{Binding LabelOpen}"
                                            Tag="{Binding}"
                                            Click="OnOpenClicked"/>
                                    <Button Grid.Column="4"
                                            Content="{Binding LabelDelete}"
                                            Tag="{Binding}"
                                            Click="OnDeleteClicked"
                                            Foreground="Red"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Cancel button -->
        <Button Grid.Row="5"
                Content="{Binding LabelCancel}"
                Margin="0,4,0,0"
                Click="OnCancelClicked"/>

    </Grid>
</UserControl>
