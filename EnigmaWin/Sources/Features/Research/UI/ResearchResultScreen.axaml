<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Research.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="800"
             x:DataType="ui:ResearchResultViewModel"
             x:Class="EnigmaWin.Sources.Features.Research.UI.ResearchResultScreen">

    <Grid RowDefinitions="Auto,*" Margin="8">

        <!-- Header bar -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">

            <!-- Buttons row -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Content="{Binding LabelBack}"
                        Click="OnBackClicked"/>
                <Button Grid.Column="2"
                        Content="{Binding ToggleLabel}"
                        IsVisible="{Binding ShowToggleButton}"
                        Click="OnToggleClicked"/>
                <Button Grid.Column="3"
                        Content="{Binding LabelExport}"
                        Click="OnExportClicked"/>
                <Button Grid.Column="4"
                        Content="?"
                        ToolTip.Tip="{Binding TooltipHelp}"
                        Click="OnHelpClicked"/>
            </Grid>

            <!-- Title + project info -->
            <TextBlock Text="{Binding LabelTitle}" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"/>
                <TextBlock Text="—" Opacity="0.5"/>
                <TextBlock Text="{Binding InquiryDisplay}" Opacity="0.8"/>
            </StackPanel>

            <!-- Skipped warning -->
            <TextBlock Text="{Binding SkippedMessage}"
                       IsVisible="{Binding HasSkipped}"
                       Foreground="Orange" FontSize="12"/>

            <!-- Export feedback — code-behind sets Name so we can show/hide/colour it -->
            <TextBlock x:Name="ExportFeedbackBlock"
                       Text="{Binding ExportMessage}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>

        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,8,0">

                <!-- ── MATRIX INQUIRIES (Signs / Houses / Aspects) ─────────── -->

                <StackPanel IsVisible="{Binding IsMatrixInquiry}" Spacing="12">

                    <!-- Data matrix -->
                    <Border BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LabelData}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="0">
                                    <!-- Column header row -->
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding LabelFactor}"
                                                   Width="150" FontWeight="SemiBold" FontSize="11"
                                                   Opacity="0.7"/>
                                        <ItemsControl ItemsSource="{Binding MatrixColumnHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}"
                                                               Width="52" FontWeight="SemiBold"
                                                               FontSize="11" Opacity="0.7"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding LabelTotal}"
                                                   Width="70" FontWeight="SemiBold"
                                                   FontSize="11" Opacity="0.7"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                    <Separator/>
                                    <!-- Data rows -->
                                    <ItemsControl ItemsSource="{Binding DataMatrixRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="ui:MatrixRow">
                                                <StackPanel Orientation="Horizontal" Spacing="0">
                                                    <TextBlock Text="{Binding RowLabel}"
                                                               Width="150" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="x:String">
                                                                <TextBlock Text="{Binding}"
                                                                           Width="52" FontSize="11"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Total}"
                                                               Width="70" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               Margin="0,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator/>
                                    <!-- Data totals row -->
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding LabelTotal}"
                                                   Width="150" FontWeight="SemiBold" FontSize="11"/>
                                        <ItemsControl ItemsSource="{Binding DataColTotals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}"
                                                               Width="52" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding DataGrandTotal}"
                                                   Width="70" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Control matrix -->
                    <Border BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LabelControl}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="0">
                                    <!-- Column header row -->
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding LabelFactor}"
                                                   Width="150" FontWeight="SemiBold" FontSize="11"
                                                   Opacity="0.7"/>
                                        <ItemsControl ItemsSource="{Binding MatrixColumnHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}"
                                                               Width="52" FontWeight="SemiBold"
                                                               FontSize="11" Opacity="0.7"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding LabelTotal}"
                                                   Width="70" FontWeight="SemiBold"
                                                   FontSize="11" Opacity="0.7"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                    <Separator/>
                                    <!-- Control rows -->
                                    <ItemsControl ItemsSource="{Binding ControlMatrixRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="ui:MatrixRow">
                                                <StackPanel Orientation="Horizontal" Spacing="0">
                                                    <TextBlock Text="{Binding RowLabel}"
                                                               Width="150" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="x:String">
                                                                <TextBlock Text="{Binding}"
                                                                           Width="52" FontSize="11"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Total}"
                                                               Width="70" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               Margin="0,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator/>
                                    <!-- Control totals row -->
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding LabelTotal}"
                                                   Width="150" FontWeight="SemiBold" FontSize="11"/>
                                        <ItemsControl ItemsSource="{Binding ControlColTotals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}"
                                                               Width="52" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ControlGrandTotal}"
                                                   Width="70" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ── LIST INQUIRIES ─────────────────────────────────────── -->

                <StackPanel IsVisible="{Binding IsListInquiry}" Spacing="12">

                    <!-- Harmonic number info (Harmonics only) -->
                    <TextBlock Text="{Binding HarmonicInfoLine}"
                               IsVisible="{Binding IsHarmonics}"
                               FontSize="12" Opacity="0.7"/>

                    <!-- OOB obliquity info -->
                    <TextBlock Text="{Binding OobInfoLine}"
                               IsVisible="{Binding HasOobInfo}"
                               FontSize="12" Opacity="0.7"/>

                    <!-- Data list -->
                    <Border BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LabelData}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="0">
                                    <!-- Headers -->
                                    <ItemsControl ItemsSource="{Binding ListHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           MinWidth="120" FontWeight="SemiBold"
                                                           FontSize="11" Opacity="0.7"
                                                           Margin="0,0,12,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator/>
                                    <!-- Data rows -->
                                    <ItemsControl ItemsSource="{Binding DataListRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="ui:SimpleRow">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Col1}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col2}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col3}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col4}" MinWidth="70"  FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col5}" MinWidth="70"  FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Totals row (Unaspect, OOB) -->
                            <Separator/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding LabelTotal}" MinWidth="120" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding DataListTotal}" MinWidth="120" FontSize="11"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Control list -->
                    <Border BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LabelControl}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="0">
                                    <!-- Headers -->
                                    <ItemsControl ItemsSource="{Binding ListHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           MinWidth="120" FontWeight="SemiBold"
                                                           FontSize="11" Opacity="0.7"
                                                           Margin="0,0,12,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator/>
                                    <!-- Control rows -->
                                    <ItemsControl ItemsSource="{Binding ControlListRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="ui:SimpleRow">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Col1}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col2}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col3}" MinWidth="120" FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col4}" MinWidth="70"  FontSize="11" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Col5}" MinWidth="70"  FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Totals row (Unaspect, OOB) -->
                            <Separator/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding LabelTotal}" MinWidth="120" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ControlListTotal}" MinWidth="120" FontSize="11"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
