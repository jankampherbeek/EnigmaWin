<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:EnigmaWin.Sources.Features.Research.UI"
        x:Class="EnigmaWin.Sources.Features.Research.UI.ResearchProjectDeleteConfirmWindow"
        x:DataType="ui:ResearchProjectDeleteConfirmWindow"
        Title="{Binding LabelTitle}"
        Width="420" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding LabelCancel}" Click="OnCancelClicked"/>
            <Button Content="{Binding LabelConfirm}" Classes="accent" Click="OnConfirmClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
