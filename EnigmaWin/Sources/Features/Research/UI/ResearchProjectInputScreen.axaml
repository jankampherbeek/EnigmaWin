<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Research.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="540"
             x:DataType="ui:ResearchProjectInputViewModel"
             x:Class="EnigmaWin.Sources.Features.Research.UI.ResearchProjectInputScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              MaxWidth="600" HorizontalAlignment="Left"
              Margin="8" RowSpacing="10">

            <!-- Title + help button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="?"
                        VerticalAlignment="Top"
                        ToolTip.Tip="{Binding TooltipHelp}"
                        Click="OnHelpClicked"/>
            </Grid>

            <!-- Name -->
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding LabelName}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Name}" />
            </StackPanel>

            <!-- Description -->
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="{Binding LabelDescription}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Description}" />
            </StackPanel>

            <!-- Inquiry type -->
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock Text="{Binding LabelInquiry}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding InquiryItems}"
                          SelectedItem="{Binding SelectedInquiryItem}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Control group multiplier -->
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock Text="{Binding LabelCgMult}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CgMultiplicationText}"
                         MaxWidth="100"
                         HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Project folder -->
            <StackPanel Grid.Row="5" Spacing="4">
                <TextBlock Text="{Binding LabelPath}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedPathDisplay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Opacity="0.8"/>
                    <Button Grid.Column="1"
                            Content="{Binding LabelSelectPath}"
                            Click="OnSelectFolderClicked"/>
                </Grid>
            </StackPanel>

            <!-- Error message -->
            <TextBlock Grid.Row="6"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       IsVisible="{Binding HasError}"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Content="{Binding LabelCancel}"
                        Click="OnCancelClicked"/>
                <Button Grid.Column="2"
                        Content="{Binding LabelNext}"
                        Classes="accent"
                        IsEnabled="{Binding CanProceed}"
                        Click="OnNextClicked"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
