<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.Cycles.CyclesAstronomical.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:DataType="ui:AstronomicalCyclesScreenViewModel"
             x:Class="EnigmaWin.Sources.Features.Cycles.CyclesAstronomical.UI.AstronomicalCyclesScreen">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16">

            <!-- Title -->
            <TextBlock Text="{Binding LabelTitle}" FontSize="18" FontWeight="SemiBold"/>

            <!-- Start date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelStartDate}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StartYearText, Mode=TwoWay}" Width="80"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding StartMonth, Mode=TwoWay}" Width="78"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding StartDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding StartCalendar, Mode=TwoWay}"
                                  Width="110">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding StartYearCount, Mode=TwoWay}"
                                  Width="130">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding StartDateError}" Foreground="Red" FontSize="12"
                               IsVisible="{Binding HasStartDateError}"/>
                </StackPanel>
            </Border>

            <!-- End date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LabelEndDate}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EndYearText, Mode=TwoWay}" Width="80"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding EndMonth, Mode=TwoWay}" Width="78"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding EndDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding EndCalendar, Mode=TwoWay}"
                                  Width="110">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding EndYearCount, Mode=TwoWay}"
                                  Width="130">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding EndDateError}" Foreground="Red" FontSize="12"
                               IsVisible="{Binding HasEndDateError}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DateOrderError}" Foreground="Red" FontSize="12"
                       IsVisible="{Binding HasDateOrderError}"/>

            <!-- Observer position -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LabelObserverPos}" VerticalAlignment="Center" Width="160"/>
                <ComboBox ItemsSource="{Binding AllObserverPositions}"
                          SelectedItem="{Binding ObserverPosition, Mode=TwoWay}"
                          Width="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Coordinate -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LabelCoordinate}" VerticalAlignment="Center" Width="160"/>
                <ComboBox ItemsSource="{Binding AvailableCoordinates}"
                          SelectedItem="{Binding SelectedCoordinate, Mode=TwoWay}"
                          Width="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Ayanamsha -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LabelAyanamsha}" VerticalAlignment="Center" Width="160"/>
                <ComboBox ItemsSource="{Binding AllAyanamshas}"
                          SelectedItem="{Binding Ayanamsha, Mode=TwoWay}"
                          Width="280">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Mode toggle -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton Content="{Binding LabelSingleFactors}"
                             IsChecked="{Binding IsSingleMode, Mode=TwoWay}" GroupName="FactorMode"/>
                <RadioButton Content="{Binding LabelPairsOfFactors}"
                             IsChecked="{Binding IsPairsMode, Mode=TwoWay}" GroupName="FactorMode"/>
            </StackPanel>

            <!-- Single factor selector -->
            <StackPanel IsVisible="{Binding IsSingleMode}" Spacing="4">
                <TextBlock Text="{Binding SelectedCountLabel}" FontSize="12" Foreground="Gray"/>
                <ScrollViewer Height="260" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FactorItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:FactorItem">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Pairs selector -->
            <StackPanel IsVisible="{Binding IsPairsMode}" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="4" Width="220">
                        <TextBlock Text="{Binding LabelFactorA}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AllFactorChoices}"
                                  SelectedItem="{Binding PendingChoiceA, Mode=TwoWay}"
                                  Width="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ui:FactorChoiceItem">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4" Width="220">
                        <TextBlock Text="{Binding LabelFactorB}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AllFactorChoices}"
                                  SelectedItem="{Binding PendingChoiceB, Mode=TwoWay}"
                                  Width="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ui:FactorChoiceItem">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <Button Content="{Binding LabelAddPair}" Command="{Binding AddPairCommand}"/>
                <StackPanel IsVisible="{Binding FactorPairs.Count}">
                    <TextBlock Text="{Binding LabelAddedPairs}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding FactorPairs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:FactorPairItem">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Command="{Binding RemoveCommand}"
                                            Padding="4,2" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Calculate button and warning -->
            <Button Content="{Binding LabelCalculate}" Command="{Binding CalculateCommand}"/>
            <TextBlock Text="{Binding PeriodWarning}" Foreground="Orange" FontSize="12"
                       IsVisible="{Binding HasPeriodWarning}" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
