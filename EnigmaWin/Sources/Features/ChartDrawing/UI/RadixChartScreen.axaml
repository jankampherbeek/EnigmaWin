<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.ChartDrawing.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700"
             x:DataType="ui:RadixChartViewModel"
             x:Class="EnigmaWin.Sources.Features.ChartDrawing.UI.RadixChartScreen">

   <Grid RowDefinitions="*,Auto" Margin="4">

       <!-- Zodiac (sign-based) wheel -->
       <ui:ZodiacWheelCanvas x:Name="ZodiacCanvas"
                             Grid.Row="0"
                             PlotData="{Binding PlotData}"
                             Theme="{Binding Theme}"
                             ShowAspects="{Binding ShowAspects}"
                             IsVisible="{Binding IsZodiacWheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- House-based wheel -->
       <ui:HouseWheelCanvas x:Name="HouseCanvas"
                            Grid.Row="0"
                            PlotData="{Binding HousePlotData}"
                            Theme="{Binding Theme}"
                            IsVisible="{Binding IsHouseWheel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

       <!-- French-style wheel -->
       <ui:FrenchWheelCanvas x:Name="FrenchCanvas"
                             Grid.Row="0"
                             PlotData="{Binding PlotData}"
                             Theme="{Binding Theme}"
                             ShowAspects="{Binding ShowAspects}"
                             IsVisible="{Binding IsFrenchWheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- Placeholder when no chart is loaded -->
       <TextBlock Grid.Row="0"
                  Text="Geen horoscoop geladen."
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="0.5"
                  IsVisible="{Binding !HasChart}"/>

       <!-- Toggle buttons -->
       <StackPanel Grid.Row="1"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Spacing="8"
                   Margin="0,6,0,0">
           <Button Command="{Binding ToggleBlackWhiteCommand}"
                   Content="{Binding LabelBlackWhite}"/>
           <Button Command="{Binding ToggleTimeCommand}"
                   Content="{Binding LabelTime}"/>
           <Button Content="{Binding LabelExport}"
                   Click="OnExportClicked"/>
       </StackPanel>

   </Grid>
</UserControl>
