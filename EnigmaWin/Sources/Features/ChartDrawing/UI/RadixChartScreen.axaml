<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:EnigmaWin.Sources.Features.ChartDrawing.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="700"
             x:DataType="ui:RadixChartViewModel"
             x:Class="EnigmaWin.Sources.Features.ChartDrawing.UI.RadixChartScreen">

   <Grid RowDefinitions="Auto,*" Margin="4">

       <!-- Top navigation bar -->
       <Border Grid.Row="0"
               BorderThickness="0,0,0,1"
               Padding="8,6,8,6">
           <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Spacing="8">
               <!-- Dial type switcher: visible on any dial type -->
               <ToggleButton Content="{Binding LabelDial360}"
                             IsVisible="{Binding IsAnyDial}"
                             IsChecked="{Binding IsDial360Wheel}"
                             Click="OnDialTypeClicked"
                             Tag="360"/>
               <ToggleButton Content="{Binding LabelDial90}"
                             IsVisible="{Binding IsAnyDial}"
                             IsChecked="{Binding IsDial90Wheel}"
                             Click="OnDialTypeClicked"
                             Tag="90"/>
               <ToggleButton Content="{Binding LabelDial45}"
                             IsVisible="{Binding IsAnyDial}"
                             IsChecked="{Binding IsDial45Wheel}"
                             Click="OnDialTypeClicked"
                             Tag="45"/>

               <Button Command="{Binding ToggleBlackWhiteCommand}"
                       ToolTip.Tip="{Binding LabelBlackWhite}">
                   <Image Source="avares://EnigmaWin/Assets/color.png" Width="16" Height="16"/>
               </Button>
               <Button Command="{Binding ToggleAspectsCommand}"
                       IsVisible="{Binding !IsAnyDial}"
                       ToolTip.Tip="{Binding LabelAspects}">
                   <Image Source="avares://EnigmaWin/Assets/aspect.png" Width="16" Height="16"/>
               </Button>
               <Button Command="{Binding ToggleTimeCommand}"
                       IsVisible="{Binding !IsAnyDial}"
                       ToolTip.Tip="{Binding LabelTime}">
                   <Image Source="avares://EnigmaWin/Assets/clock.png" Width="16" Height="16"/>
               </Button>
               <Button Content="{Binding LabelExport}"
                       Click="OnExportClicked"/>
               <Button Content="{Binding LabelHelp}"
                       Click="OnHelpClicked"/>
           </StackPanel>
       </Border>

       <!-- Zodiac (sign-based) wheel -->
       <ui:ZodiacWheelCanvas x:Name="ZodiacCanvas"
                             Grid.Row="1"
                             PlotData="{Binding PlotData}"
                             Theme="{Binding Theme}"
                             ShowAspects="{Binding ShowAspects}"
                             IsVisible="{Binding IsZodiacWheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- House-based wheel -->
       <ui:HouseWheelCanvas x:Name="HouseCanvas"
                            Grid.Row="1"
                            PlotData="{Binding HousePlotData}"
                            Theme="{Binding Theme}"
                            IsVisible="{Binding IsHouseWheel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

       <!-- French-style wheel -->
       <ui:FrenchWheelCanvas x:Name="FrenchCanvas"
                             Grid.Row="1"
                             PlotData="{Binding PlotData}"
                             Theme="{Binding Theme}"
                             ShowAspects="{Binding ShowAspects}"
                             IsVisible="{Binding IsFrenchWheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- Ring-style wheel -->
       <ui:RingWheelCanvas x:Name="RingCanvas"
                           Grid.Row="1"
                           PlotData="{Binding PlotData}"
                           Theme="{Binding Theme}"
                           ShowAspects="{Binding ShowAspects}"
                           IsVisible="{Binding IsRingWheel}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>

       <!-- Dial 360° wheel -->
       <ui:Dial360WheelCanvas x:Name="Dial360Canvas"
                              Grid.Row="1"
                              PlotData="{Binding DialPlotData}"
                              Theme="{Binding Theme}"
                              IsVisible="{Binding IsDial360Wheel}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

       <!-- Dial 90° wheel -->
       <ui:Dial90WheelCanvas x:Name="Dial90Canvas"
                             Grid.Row="1"
                             PlotData="{Binding Dial90PlotData}"
                             Theme="{Binding Theme}"
                             IsVisible="{Binding IsDial90Wheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- Dial 45° wheel -->
       <ui:Dial45WheelCanvas x:Name="Dial45Canvas"
                             Grid.Row="1"
                             PlotData="{Binding Dial45PlotData}"
                             Theme="{Binding Theme}"
                             IsVisible="{Binding IsDial45Wheel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

       <!-- Placeholder when no chart is loaded -->
       <TextBlock Grid.Row="1"
                  Text="Geen horoscoop geladen."
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="0.5"
                  IsVisible="{Binding !HasChart}"/>

   </Grid>
</UserControl>
