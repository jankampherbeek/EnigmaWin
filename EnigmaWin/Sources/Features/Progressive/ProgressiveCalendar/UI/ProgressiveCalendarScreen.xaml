<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.ProgressiveCalendar.UI.ProgressiveCalendarScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Progressive.ProgressiveCalendar.UI">

    <Border Padding="20,16,20,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LabelResultsTitle}" FontSize="18" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="?" ToolTip="{Binding LabelResultsHelp}" Click="OnHelpClicked"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Height="6" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LabelCalculating}" Opacity="0.7"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding LabelNoResults}" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResults}" Value="False"/>
                                            <Condition Binding="{Binding HasError}" Value="False"/>
                                            <Condition Binding="{Binding IsCalculating}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- All diagrams first, one per technique -->
                    <ItemsControl ItemsSource="{Binding TechniqueSections}"
                                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:ProgressiveCalendarTechniqueSection}">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DataContext.LabelSectionDiagram, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>

                                    <!-- Timeline diagram -->
                                    <ui:ProgressiveCalendarTimelineCanvas
                                        Episodes="{Binding DiagramEpisodes}"
                                        Events="{Binding DiagramEvents}"
                                        StartJD="{Binding StartJD}"
                                        EndJD="{Binding EndJD}"
                                        x:Name="TimelineCanvas"
                                        Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ElementName=TimelineCanvas, Path=SelectedDateText}"
                                               FontSize="11" Opacity="0.7">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=TimelineCanvas, Path=SelectedDateText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Legend: what each diagram color/tick means -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Cyan" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendParallel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Indigo" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendContraParallel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Orange" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendStation, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Red" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendOob, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Green" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendDeclination, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                            <Ellipse Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding DataContext.LabelLegendCuspConjunction, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Opacity="0.65"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- All tables afterward, one block per technique -->
                    <ItemsControl ItemsSource="{Binding TechniqueSections}"
                                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:ProgressiveCalendarTechniqueSection}">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Aspects & parallels table -->
                                    <StackPanel Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DataContext.LabelSectionAspectsParallels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                                        <GroupBox Padding="8">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <Grid Margin="4,0,4,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="4" Text="{Binding DataContext.LabelColEnter, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding DataContext.LabelColExact, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding DataContext.LabelColExit, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding DataContext.LabelColOrb, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding EpisodeRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ui:ProgressiveCalendarEpisodeRow}">
                                                                <Grid Margin="0,1"
                                                                      Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Factor1Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" Margin="2"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding KindGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" Margin="2"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Factor2Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" Margin="2"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding TargetLabel}" FontSize="11" Opacity="0.7" Margin="2"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding EnterText}" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                                                    <TextBlock Grid.Column="5" Text="{Binding ExactText}" FontFamily="Consolas" FontSize="12" Margin="2" Opacity="0.75"/>
                                                                    <TextBlock Grid.Column="6" Text="{Binding ExitText}" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                                                    <TextBlock Grid.Column="7" Text="{Binding OrbText}" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" Margin="2"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </GroupBox>
                                    </StackPanel>

                                    <!-- Other events table -->
                                    <StackPanel Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding DataContext.LabelSectionOtherEvents, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                                        <GroupBox Padding="8">
                                            <StackPanel>
                                                <Grid Margin="4,0,4,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="2" Text="{Binding DataContext.LabelColDate, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DataContext.LabelColPosition, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding EventRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type ui:ProgressiveCalendarEventRow}">
                                                            <Grid Margin="0,1"
                                                                  Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" Margin="2"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="11" Opacity="0.7" Margin="2"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding DateText}" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
                                                                    <TextBlock Text="{Binding PositionDms}" FontFamily="Consolas" FontSize="12"/>
                                                                    <TextBlock Text="{Binding PositionSignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="13" Margin="3,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
