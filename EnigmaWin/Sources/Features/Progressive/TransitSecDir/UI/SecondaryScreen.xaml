<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.TransitSecDir.UI.SecondaryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Progressive.TransitSecDir.UI"
             xmlns:midpointsUi="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI"
             xmlns:progressive="clr-namespace:EnigmaWin.Sources.Features.Progressive.DualWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab selector row -->
        <Border Grid.Row="0" Padding="20,12,20,0">
            <StackPanel>

                <!-- No results placeholder -->
                <TextBlock Text="{Binding LabelNoResults}" Opacity="0.6" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResults}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelResultsTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="?" ToolTip="{Binding LabelResultsHelp}" Click="OnHelpClicked"/>
                    </Grid>

                    <!-- Tab selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="{Binding LabelTabPositions}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqualsZero}, Mode=TwoWay}"
                                     GroupName="SecondaryTabs" Margin="0,0,12,0"/>
                        <RadioButton Content="{Binding LabelTabMatches}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqualsOne}, Mode=TwoWay}"
                                     GroupName="SecondaryTabs" Margin="0,0,12,0"/>
                        <RadioButton Content="{Binding LabelTabMidpoints}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqualsTwo}, Mode=TwoWay}"
                                     GroupName="SecondaryTabs" Margin="0,0,12,0"/>
                        <RadioButton Content="{Binding LabelTabDualWheel}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqualsThree}, Mode=TwoWay}"
                                     GroupName="SecondaryTabs"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Dual-wheel toolbar (only visible on tab 3) -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" Padding="8,4,8,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="3">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding LabelWheelBlackWhite}"
                        Command="{Binding ToggleBlackWhiteCommand}"
                        Margin="2,0"/>
                <Button Content="{Binding LabelWheelAspects}"
                        Command="{Binding ToggleAspectsCommand}"
                        Margin="2,0"/>
                <Button Content="{Binding LabelWheelExport}"
                        Click="OnExportClicked"
                        Margin="2,0"/>
            </StackPanel>
        </Border>

        <!-- Tab content row (fills remaining space) -->
        <Border Grid.Row="2" Padding="20,0,20,20">
          <Grid>

            <!-- Positions tab -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <GroupBox Padding="8"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LabelColFactor}"      FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelColLongitude}"   FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelColDeclination}" FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PositionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:TransitPositionRow}">
                                    <Grid Margin="0,1"
                                          Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FactorGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                   HorizontalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LongitudeText}"
                                                   HorizontalAlignment="Right" Margin="4"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SignGlyph}"
                                                   FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="2,4"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DeclinationText}"
                                                   HorizontalAlignment="Right" Margin="4" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
            </ScrollViewer>

            <!-- Aspects tab (tab 1) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelNoMatches}" Opacity="0.6" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MatchRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <GroupBox Padding="8">
                        <GroupBox.Style>
                            <Style TargetType="GroupBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MatchRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GroupBox.Style>
                        <StackPanel>
                            <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="{Binding LabelMatchColOrb}"
                                               FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LabelMatchColExactness}"
                                               FontWeight="SemiBold" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding MatchRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:TransitMatchRow}">
                                        <Grid Margin="0,1"
                                              Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TransitGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       HorizontalAlignment="Center" Margin="4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MatchGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       HorizontalAlignment="Center" Margin="4"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RadixGlyph}"
                                                       FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                       HorizontalAlignment="Center" Margin="4"/>
                                            <TextBlock Grid.Column="3" Text="{Binding OrbText}"
                                                       HorizontalAlignment="Right" Margin="4" Opacity="0.7"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ExactnessText}"
                                                       HorizontalAlignment="Right" Margin="4" Opacity="0.7"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Midpoints tab (tab 2) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,8,0,0">

                    <!-- Dial picker -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="{Binding LabelDial360}"
                                     IsChecked="{Binding MidpointDialType, Converter={StaticResource EnumEqualsDialZero}, Mode=TwoWay}"
                                     GroupName="SecondaryDial" Margin="0,0,12,0"/>
                        <RadioButton Content="{Binding LabelDial90}"
                                     IsChecked="{Binding MidpointDialType, Converter={StaticResource EnumEqualsDialOne}, Mode=TwoWay}"
                                     GroupName="SecondaryDial" Margin="0,0,12,0"/>
                        <RadioButton Content="{Binding LabelDial45}"
                                     IsChecked="{Binding MidpointDialType, Converter={StaticResource EnumEqualsDialTwo}, Mode=TwoWay}"
                                     GroupName="SecondaryDial"/>
                    </StackPanel>

                    <!-- Radix midpoints section -->
                    <TextBlock Text="{Binding LabelMidpointsRadixHeader}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LabelMidpointsNoMatches}" Opacity="0.6" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RadixMidpointRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RadixMidpointRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <midpointsUi:MidpointTreePanelControl Matches="{Binding RadixMidpointMatches}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,0,4"/>
                        <Separator Margin="0,8,0,8"/>
                        <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LabelMidpointsColFactor1}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelMidpointsColFactor2}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelMidpointsColMidpoint}"  FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LabelMidpointsColPlanet}"    FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LabelMidpointsColOrb}"       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding LabelMidpointsColExactness}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                </Grid>
                                <Separator Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding RadixMidpointRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:ProgressiveMidpointRow}">
                                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Glyph1}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Glyph2}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                        <TextBlock Text="{Binding MidpointSignGlyph}"
                                                                   FontFamily="{StaticResource GlyphFont}" FontSize="16" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding PlanetGlyph}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding OrbText}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding ExactnessText}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator Margin="0,8,0,12"/>

                    <!-- Secondary midpoints section -->
                    <TextBlock Text="{Binding LabelMidpointsProgressiveHeader}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LabelMidpointsNoMatches}" Opacity="0.6" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressiveMidpointRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressiveMidpointRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <midpointsUi:MidpointTreePanelControl Matches="{Binding ProgressiveMidpointMatches}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,0,4"/>
                        <Separator Margin="0,8,0,8"/>
                        <Border BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LabelMidpointsColFactor1}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelMidpointsColFactor2}"   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelMidpointsColMidpoint}"  FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LabelMidpointsColPlanet}"    FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="4" Text="{Binding LabelMidpointsColOrb}"       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding LabelMidpointsColExactness}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
                                </Grid>
                                <Separator Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding ProgressiveMidpointRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:ProgressiveMidpointRow}">
                                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Glyph1}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Glyph2}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MidpointDms}" FontSize="13"/>
                                                        <TextBlock Text="{Binding MidpointSignGlyph}"
                                                                   FontFamily="{StaticResource GlyphFont}" FontSize="16" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding PlanetGlyph}"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding OrbText}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding ExactnessText}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Dual Wheel tab (tab 3) -->
            <progressive:DualWheelCanvas
                RadixData="{Binding RadixPlotData}"
                TransitItems="{Binding TransitPlotItems}"
                Theme="{Binding Theme}"
                ShowAspects="{Binding ShowAspects}">
                <progressive:DualWheelCanvas.Style>
                    <Style TargetType="progressive:DualWheelCanvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </progressive:DualWheelCanvas.Style>
            </progressive:DualWheelCanvas>

          </Grid>
        </Border>
    </Grid>
</UserControl>
