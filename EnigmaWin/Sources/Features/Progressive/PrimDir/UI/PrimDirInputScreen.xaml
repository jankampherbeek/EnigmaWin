<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.PrimDir.UI.PrimDirInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Inner}">

    <Border Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600">

                <!-- Title row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="20" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="📄" ToolTip="{Binding LabelFactsheetTooltip}" Click="OnFactsheetClicked" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked"/>
                </Grid>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12" Margin="0,0,0,8"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- No session message -->
                <TextBlock Text="{Binding LabelNoSession}" Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCharts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Chart picker -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelChartSection}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding Charts}"
                              SelectedItem="{Binding SelectedChart, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="250"/>
                </StackPanel>

                <!-- Mode picker -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelModeLabel}" FontWeight="Medium" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding LabelModeDateRange}"
                                     IsChecked="{Binding IsEventMode, Mode=TwoWay, Converter={StaticResource BoolNegation}}"
                                     GroupName="PrimDirMode" Margin="0,0,16,0"/>
                        <RadioButton Content="{Binding LabelModeEvent}"
                                     IsChecked="{Binding IsEventMode, Mode=TwoWay}"
                                     GroupName="PrimDirMode"/>
                    </StackPanel>
                </StackPanel>

                <!-- Date range section -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEventMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding LabelStartDate}" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" HorizontalAlignment="Left"
                             ToolTip="{Binding LabelDatePlaceholder}"/>
                    <TextBlock Text="{Binding LabelEndDate}" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" HorizontalAlignment="Left"
                             ToolTip="{Binding LabelDatePlaceholder}"/>
                </StackPanel>

                <!-- Event picker section -->
                <StackPanel Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEventMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding LabelEventPicker}" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LabelNoEvents}" Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding Events}"
                              SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              MinWidth="280"
                              Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Settings override -->
                <GroupBox Margin="0,0,0,12"
                          Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <GroupBox.Header>
                        <TextBlock Text="{Binding LabelSettingsHeader}" FontWeight="Medium"/>
                    </GroupBox.Header>
                    <StackPanel Margin="4,8,4,4">
                        <TextBlock Text="{Binding LabelSettingsNote}" Opacity="0.6" FontSize="11" Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelMethod}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding MethodNames}"
                                      SelectedIndex="{Binding SelectedMethodIndex, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelApproach}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding ApproachNames}"
                                      SelectedIndex="{Binding SelectedApproachIndex, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelTimeKey}" VerticalAlignment="Center" Margin="0,4"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,4,0,4"
                                      ItemsSource="{Binding TimeKeyNames}"
                                      SelectedIndex="{Binding SelectedTimeKeyIndex, Mode=TwoWay}"/>

                            <Button Grid.Row="3" Grid.Column="1" Content="{Binding LabelSettingsReset}"
                                    Command="{Binding SyncFromConfigCommand}"
                                    HorizontalAlignment="Left" Margin="8,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Calculate button -->
                <Button Content="{Binding LabelCalculate}"
                        Command="{Binding CalculateCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
