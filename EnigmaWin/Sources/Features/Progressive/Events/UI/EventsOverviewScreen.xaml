<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.Events.UI.EventsOverviewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Progressive.Events.UI">

    <Border Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900">

                <!-- Title row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="24" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked"/>
                </Grid>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12" Margin="0,0,0,8"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- No session message -->
                <TextBlock Text="{Binding LabelNoSession}"
                           Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCharts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Chart picker -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelChartSection}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding Charts}"
                              SelectedItem="{Binding SelectedChart, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="250"/>
                </StackPanel>

                <!-- Create button -->
                <Button Content="{Binding LabelCreate}"
                        Command="{Binding NavigateToCreateEventCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Empty message -->
                <TextBlock Text="{Binding LabelEmpty}" Opacity="0.6"
                           Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Events table -->
                <GroupBox Header="{Binding LabelEventsHeader}" Padding="8"
                          Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Column headers -->
                            <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LabelColTitle}"    FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelColDateTime}" FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelColLocation}" FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                </Grid>
                            </Border>
                            <!-- Rows -->
                            <ItemsControl ItemsSource="{Binding EventRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:EventRow}">
                                        <Grid Margin="0,1" Cursor="Hand"
                                              Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}"
                                              MouseLeftButtonUp="OnRowClicked">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding LabelEdit}"
                                                              Tag="{Binding}"
                                                              Click="OnEditMenuClicked"/>
                                                    <MenuItem Header="{Binding LabelDelete}"
                                                              Tag="{Binding}"
                                                              Click="OnDeleteMenuClicked"
                                                              Foreground="Red"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,4,4,4">
                                                <TextBlock Text="✓ " Foreground="CornflowerBlue"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDateTime}"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="4,4,4,4" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayLocation}"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="4,4,4,4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
