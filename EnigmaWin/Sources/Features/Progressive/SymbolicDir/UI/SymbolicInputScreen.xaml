<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.SymbolicDir.UI.SymbolicInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Progressive.SymbolicDir.UI"
             xmlns:eventsUi="clr-namespace:EnigmaWin.Sources.Features.Progressive.Events.UI"
             DataContext="{Binding Inner}">

    <Border Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600">

                <!-- Title row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="20" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="📄" ToolTip="Factsheet" Click="OnFactsheetClicked" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="?" ToolTip="{Binding LabelHelp}" Click="OnHelpClicked"/>
                </Grid>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12" Margin="0,0,0,8"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- No session message -->
                <TextBlock Text="{Binding LabelNoSession}" Opacity="0.6" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCharts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Chart picker -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelChartSection}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding Charts}"
                              SelectedItem="{Binding SelectedChart, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="250"/>
                </StackPanel>

                <!-- Arc method picker -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LabelArcMethod}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding SymbolicKeyValues}"
                              SelectedItem="{Binding SelectedSymbolicKey, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              MinWidth="200"/>
                </StackPanel>

                <!-- No events message -->
                <TextBlock Text="{Binding LabelNoEvents}" Opacity="0.6" Margin="0,0,0,8"
                           Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Events table -->
                <GroupBox Header="{Binding LabelEventsHeader}" Padding="8" Margin="0,0,0,12"
                          Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Column headers -->
                            <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="4,0,4,4" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LabelColTitle}"    FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelColDateTime}" FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelColLocation}" FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                </Grid>
                            </Border>
                            <!-- Rows -->
                            <ItemsControl ItemsSource="{Binding EventRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type eventsUi:EventRow}">
                                        <Grid Margin="0,1"
                                              Background="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4">
                                                <TextBlock Text="✓ " Foreground="CornflowerBlue"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDateTime}"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="4" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayLocation}"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="4" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="{Binding LabelSelect}"
                                                    Tag="{Binding}" Click="OnSelectClicked" Margin="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- Calculate button -->
                <Button Content="{Binding LabelCalculate}"
                        Command="{Binding CalculateCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
