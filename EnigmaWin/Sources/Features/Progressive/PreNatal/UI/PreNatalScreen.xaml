<UserControl x:Class="EnigmaWin.Sources.Features.Progressive.PreNatal.UI.PreNatalScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Progressive.PreNatal.UI">

    <Border Padding="20,16,20,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LabelResultsTitle}" FontSize="18" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="📄" ToolTip="{Binding LabelResultsHelp}"
                        Click="OnFactsheetClicked" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="?" ToolTip="{Binding LabelResultsHelp}"
                        Click="OnHelpClicked"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- No-results placeholder -->
                    <TextBlock Text="{Binding LabelNoResults}" Margin="0,8,0,0" Opacity="0.6" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Results block -->
                    <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">

                        <!-- Info text (date range) -->
                        <TextBlock Text="{Binding InfoText}" Opacity="0.7" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInfoText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Hint: click a row to select it for correction -->
                        <TextBlock Text="{Binding LabelSelectMoment}" Opacity="0.55" FontSize="11"
                                   Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <!-- Results table -->
                        <GroupBox Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Column headers -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="LightGray"
                                        Padding="4,0,4,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LabelColActualDate}"   FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LabelColType}"         FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LabelColPosition1}"    FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Grid.Column="6" Text="{Binding LabelColPosition2}"    FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Grid.Column="8" Text="{Binding LabelColPrenatalDate}" FontWeight="SemiBold" FontSize="11" Opacity="0.65"/>
                                    </Grid>
                                </Border>

                                <!-- Data rows — clicking selects the prenatal moment for correction -->
                                <ListBox ItemsSource="{Binding ResultRows}"
                                         SelectedItem="{Binding SelectedMomentRow, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="{Binding IsOddRow, Converter={StaticResource BoolToRowBgConverter}}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:PreNatalResultRow}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ActualDateText}"
                                                           FontFamily="Consolas" FontSize="12" Margin="4,2"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeGlyphs}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                           Margin="4,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeIsGlyph}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}"
                                                           FontSize="12" Margin="4,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeIsGlyph}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Factor1Glyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                           HorizontalAlignment="Center" Margin="2,2"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Longitude1Text}"
                                                           FontFamily="Consolas" FontSize="12" Margin="4,2"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Sign1Glyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                           HorizontalAlignment="Center" Margin="2,2"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Factor2Glyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                           HorizontalAlignment="Center" Margin="2,2"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Longitude2Text}"
                                                           FontFamily="Consolas" FontSize="12" Margin="4,2"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Sign2Glyph}"
                                                           FontFamily="{StaticResource GlyphFont}" FontSize="18"
                                                           HorizontalAlignment="Center" Margin="2,2"/>
                                                <TextBlock Grid.Column="8" Text="{Binding PrenatalDateText}"
                                                           FontFamily="Consolas" FontSize="11" Opacity="0.7"
                                                           Margin="4,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
