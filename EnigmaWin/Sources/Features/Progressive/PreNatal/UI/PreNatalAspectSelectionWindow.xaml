<Window x:Class="EnigmaWin.Sources.Features.Progressive.PreNatal.UI.PreNatalAspectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Aspects"
        Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Select aspects to search for in pre-natal period:"
                   TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Medium"/>
        <Border BorderThickness="1" BorderBrush="LightGray" Padding="8">
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AspectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK"     IsDefault="True"  Click="OnOkClicked"     MinWidth="70" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"   Click="OnCancelClicked" MinWidth="70"/>
        </StackPanel>
    </StackPanel>
</Window>
