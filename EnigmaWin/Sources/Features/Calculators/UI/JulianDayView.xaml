<UserControl x:Class="EnigmaWin.Sources.Features.Calculators.UI.JulianDayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" MaxWidth="860">

            <TextBlock Text="{Binding LabelTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Section 1: Date and time → Julian Day -->
            <GroupBox Header="{Binding LabelDateTimeToJd}" Margin="0,0,0,16" Padding="12">
                <StackPanel>

                    <!-- Date row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelDate}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Text="{Binding Year, Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="2" ItemsSource="{Binding MonthValues}"  SelectedItem="{Binding Month,  Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="3" ItemsSource="{Binding DayValues}"    SelectedItem="{Binding Day,    Mode=TwoWay}"/>
                    </Grid>

                    <!-- Calendar / Year count row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelCalendarYearCount}" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" ItemsSource="{Binding CalendarValues}"  SelectedItem="{Binding Calendar,  Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="2" ItemsSource="{Binding YearCountValues}" SelectedItem="{Binding YearCount, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Time row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelTime}" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" ItemsSource="{Binding HourValues}"         SelectedItem="{Binding Hour,   Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="2" ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding Minute, Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="3" ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding Second, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Offset UT row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelOffsetUt}" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" ItemsSource="{Binding HourValues}"         SelectedItem="{Binding OffsetHour,    Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="2" ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding OffsetMinute,  Mode=TwoWay}" Margin="0,0,4,0"/>
                        <ComboBox  Grid.Column="3" ItemsSource="{Binding OffsetDirectionValues}" SelectedItem="{Binding OffsetDirection, Mode=TwoWay}"/>
                    </Grid>

                    <Button Content="{Binding LabelCalcJd}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,0,0,12"
                            Click="OnCalculateJulianDayClicked"/>

                    <!-- Results -->
                    <StackPanel Visibility="{Binding HasJdResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelResultJd}"     FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding JdResult}"          FontFamily="Consolas"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelResultDeltaT}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding DeltaTResult}"      FontFamily="Consolas"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <!-- Section 2: Julian Day → date and time -->
            <GroupBox Header="{Binding LabelJdToDateTime}" Padding="12">
                <StackPanel>

                    <!-- JD input row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelJdInput}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Text="{Binding JdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Button Content="{Binding LabelCalcDateTime}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,0,0,12"
                            IsEnabled="{Binding CanCalculateDateTime}"
                            Click="OnCalculateDateTimeClicked"/>

                    <!-- Results -->
                    <StackPanel Visibility="{Binding HasDateResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelResultDate}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding DateResult}"      FontFamily="Consolas"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelResultTime}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimeResult}"      FontFamily="Consolas"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
