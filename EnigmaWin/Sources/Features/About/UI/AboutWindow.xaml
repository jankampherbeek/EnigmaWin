<Window x:Class="EnigmaWin.Sources.Features.About.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" >
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding LabelDescription}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding LabelContributors}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding LabelNames}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,16"/>
        <Button Content="{Binding LabelClose}" HorizontalAlignment="Right" Click="OnCloseClicked" IsDefault="True"/>
    </StackPanel>
</Window>
