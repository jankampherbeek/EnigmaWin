<UserControl x:Class="EnigmaWin.Sources.Features.ImportExport.UI.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.ImportExport.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:ImportExportViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16"/>

            <Separator Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="{Binding LabelExport}" MinWidth="100" Padding="12,4" Margin="0,0,12,0"
                        IsEnabled="{Binding IsIdle}" Click="OnExportClicked"/>
                <Button Content="{Binding LabelImport}" MinWidth="100" Padding="12,4"
                        IsEnabled="{Binding IsIdle}" Click="OnImportClicked"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="ForestGreen" Margin="0,0,0,8"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="Firebrick"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
