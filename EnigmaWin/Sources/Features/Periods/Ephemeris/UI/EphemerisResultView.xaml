<UserControl x:Class="EnigmaWin.Sources.Features.Periods.Ephemeris.UI.EphemerisResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnigmaWin.Sources.Features.Shared.Converters">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding LabelTabTabular}" Click="OnTabTabularClick" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelTabGraphic}" Click="OnTabGraphicClick"  Margin="0,0,6,0"/>

                <!-- Table: Export PDF button (visible only when tabular + hasResults) -->
                <Button Content="{Binding LabelExportPdf}" Click="OnExportTablePdfClick" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowTabular}" Value="True"/>
                                        <Condition Binding="{Binding HasResults}"  Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Chart: Export PDF button (visible only when graphic + hasResults) -->
                <Button Content="{Binding LabelExportPdf}" Click="OnExportChartPdfClick" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowGraphic}" Value="True"/>
                                        <Condition Binding="{Binding HasResults}"  Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Chart: Export PNG button (visible only when graphic + hasResults) -->
                <Button Content="{Binding LabelExportPng}" Click="OnExportChartPngClick" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowGraphic}" Value="True"/>
                                        <Condition Binding="{Binding HasResults}"  Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- No-results placeholder -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LabelNoResults}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Tabular tab -->
        <Grid Grid.Row="1" Name="TabularPanel"
              Visibility="{Binding ShowTabular, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Table title -->
            <TextBlock Grid.Row="0" Text="{Binding TableTitle}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="4,8,4,6"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Headers + data rows in one ScrollViewer so they scroll together -->
            <ScrollViewer Grid.Row="1" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="TableFullContent">
                    <!-- Column headers -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LabelDay}" FontWeight="Bold" Width="50"
                                   TextAlignment="Right" Margin="4,4"/>
                        <ItemsControl ItemsSource="{Binding TableColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}" FontWeight="Bold" Width="100"
                                               TextAlignment="Right" Margin="4,4" TextWrapping="NoWrap"
                                               ToolTip="{Binding Header}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Data rows -->
                    <ItemsControl ItemsSource="{Binding TableRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Background="{Binding IsEven, Converter={StaticResource BoolToRowBgConverter}}">
                                <TextBlock Text="{Binding DayText}" Width="50" Margin="4,2"
                                           FontFamily="Courier New" TextAlignment="Right"/>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Margin="4,2">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DmsText}"
                                                               FontFamily="Courier New"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SignGlyph}"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Graphic tab -->
        <Grid Grid.Row="1" Name="ChartPanel"
              Visibility="{Binding ShowGraphic, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chart title (WPF TextBlock — no title inside ScottPlot) -->
            <TextBlock Grid.Row="0" Text="{Binding ChartTitle}"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="4,8,4,6"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"/>

            <!-- WpfPlot injected by code-behind -->
            <Grid Grid.Row="1" Name="GraphicPanel" Background="White"/>

            <!-- WPF legend: glyph items in a wrapping panel below the chart -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0" BorderBrush="#CCCCCC"
                    Margin="4,6,4,4" Padding="4,6,4,4"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding LegendItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,2,8,2">
                                <!-- Color swatch -->
                                <Border Width="24" Height="4"
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <!-- Factor glyph -->
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="{StaticResource GlyphFont}"
                                           FontSize="22"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

    </Grid>
</UserControl>
