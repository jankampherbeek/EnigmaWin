<UserControl x:Class="EnigmaWin.Sources.Features.Periods.Ephemeris.UI.EphemerisInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Periods.Ephemeris.UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- Title -->
            <TextBlock Text="{Binding LabelTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <!-- Month and Year -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center" Width="80"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                  Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center" Width="80"/>
                        <TextBox Text="{Binding YearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80"/>
                    </StackPanel>
                    <TextBlock Text="{Binding YearError}" Foreground="Red" FontSize="11"
                               Visibility="{Binding HasYearError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Ayanamsha -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding LabelAyanamsha}" VerticalAlignment="Center" Width="80"/>
                <ComboBox ItemsSource="{Binding AllAyanamshas}"
                          SelectedItem="{Binding Ayanamsha, Mode=TwoWay}"
                          Width="240"/>
            </StackPanel>

            <!-- Observer position -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding LabelObserver}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <RadioButton Content="{Binding LabelGeocentric}"
                                 IsChecked="{Binding IsGeocentric, Mode=TwoWay}"
                                 GroupName="ObserverGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelHeliocentric}"
                                 IsChecked="{Binding IsHeliocentric, Mode=TwoWay}"
                                 GroupName="ObserverGroup" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Coordinates — single selection -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding LabelCoordinates}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <RadioButton Content="{Binding LabelLongitude}"   IsChecked="{Binding CoordLongitude,   Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelLatitude}"    IsChecked="{Binding CoordLatitude,    Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelRa}"          IsChecked="{Binding CoordRa,          Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelDeclination}" IsChecked="{Binding CoordDeclination, Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelDistance}"    IsChecked="{Binding CoordDistance,    Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelSpeedLon}"    IsChecked="{Binding CoordSpeedLon,    Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                    <RadioButton Content="{Binding LabelSpeedDec}"    IsChecked="{Binding CoordSpeedDec,    Mode=TwoWay}" GroupName="CoordGroup" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Factor selection -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding LabelFactors}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FactorItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:EphemerisFactorItem}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,1">
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
