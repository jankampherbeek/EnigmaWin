<UserControl x:Class="EnigmaWin.Sources.Features.Periods.CyclesAstronomical.UI.CyclesChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding LabelTabChart}"     Command="{Binding ShowChartCommand}" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelTabPositions}" Command="{Binding ShowTableCommand}" Margin="0,0,6,0"/>
                <Button Content="{Binding LabelExportPng}"   Command="{Binding ExportPngCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResults}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowTable}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding LabelExportCsv}"   Command="{Binding ExportCsvCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResults}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowChart}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding LabelFormatToggle}" Command="{Binding ToggleDmsCommand}"
                        Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,6,0"/>
            </StackPanel>
        </Border>

        <!-- No-results placeholder -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LabelNoResults}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray"
                   Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Chart tab: WpfPlot injected by code-behind -->
        <Grid Grid.Row="1" Name="ChartPanel"
              Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisibility}}"
              Background="White"/>

        <!-- Table tab -->
        <Grid Grid.Row="1" Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header row -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ColumnHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold" Width="130"
                                       TextAlignment="Right" Margin="4,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Data rows -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TableRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DateText}"    Width="100" Margin="4,2" FontFamily="Courier New"/>
                                <TextBlock Text="{Binding FormattedJd}" Width="130" Margin="4,2" TextAlignment="Right" FontFamily="Courier New"/>
                                <ItemsControl ItemsSource="{Binding FormattedValues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Width="130" Margin="4,2"
                                                       TextAlignment="Right" FontFamily="Courier New"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
