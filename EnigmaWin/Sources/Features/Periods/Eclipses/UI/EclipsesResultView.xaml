<UserControl x:Class="EnigmaWin.Sources.Features.Periods.Eclipses.UI.EclipsesResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row with export/help buttons -->
        <Grid Grid.Row="0" Margin="4,4,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LabelResultsTitle}"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding LabelExportPdf}" Click="OnExportPdfClick" Margin="0,0,6,0"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"/>
            <Button Grid.Column="2" Content="?" Padding="8,2" Click="OnHelpClicked"/>
        </Grid>

        <!-- No-results placeholder -->
        <TextBlock Grid.Row="1"
                   Text="{Binding LabelNoResults}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="320"
                   Foreground="Gray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Results table -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Name="TableFullContent">

                <!-- Column headers -->
                <StackPanel Orientation="Horizontal" Margin="4,0,4,4">
                    <TextBlock Text="" Width="28"/>
                    <TextBlock Text="{Binding LabelColDate}" FontWeight="Bold" Width="150" Margin="4,0"/>
                    <TextBlock Text="{Binding LabelColPosition}" FontWeight="Bold" Width="110" Margin="4,0"/>
                    <TextBlock Text="{Binding LabelColType}" FontWeight="Bold" Width="90" Margin="4,0"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding LabelColVisible}" FontWeight="Bold" Width="60" Margin="4,0"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding LabelColSaros}" FontWeight="Bold" Width="80" Margin="4,0"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Data rows -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding EclipseGlyph}" Width="28"
                                           FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                                <TextBlock Text="{Binding DateText}" Width="150" Margin="4,0"
                                           FontFamily="Courier New"/>
                                <StackPanel Orientation="Horizontal" Width="110" Margin="4,0">
                                    <TextBlock Text="{Binding PositionText}" FontFamily="Courier New"/>
                                    <TextBlock Text="{Binding SignGlyph}"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                               Margin="2,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TypeText}" Width="90" Margin="4,0"
                                           Visibility="{Binding DataContext.HasLocation, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Width="60" Margin="4,0"
                                           Visibility="{Binding DataContext.HasLocation, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLocalData}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SarosText}" Width="80" Margin="4,0"
                                           FontFamily="Courier New"
                                           Visibility="{Binding DataContext.HasLocation, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
