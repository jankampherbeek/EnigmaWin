<UserControl x:Class="EnigmaWin.Sources.Features.Periods.Eclipses.UI.EclipsesInputScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="16">

            <!-- Title row with help button -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LabelTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="?" Padding="8,2" Click="OnHelpClicked"/>
            </Grid>

            <!-- Start date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelStartDate}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding StartYearText, Mode=TwoWay}" Width="80" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding StartMonth, Mode=TwoWay}" Width="78" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding StartDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding StartCalendar, Mode=TwoWay}"
                                  Width="110" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding StartYearCount, Mode=TwoWay}"
                                  Width="130"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StartDateError}" Foreground="Red" FontSize="12"
                               Visibility="{Binding HasStartDateError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- End date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelEndDate}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding EndYearText, Mode=TwoWay}" Width="80" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding EndMonth, Mode=TwoWay}" Width="78" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding EndDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding EndCalendar, Mode=TwoWay}"
                                  Width="110" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding EndYearCount, Mode=TwoWay}"
                                  Width="130"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EndDateError}" Foreground="Red" FontSize="12"
                               Visibility="{Binding HasEndDateError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DateOrderError}" Foreground="Red" FontSize="12"
                       Visibility="{Binding HasDateOrderError, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,0,0,8"/>

            <!-- Eclipse type -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelEclipseType}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AllEclipseSearchTypes}"
                              SelectedItem="{Binding EclipseSearchType, Mode=TwoWay}"
                              Width="200" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Location (optional) -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelLocation}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Lat" VerticalAlignment="Center" Width="30"/>
                        <TextBox Text="{Binding LatitudeDegrees, Mode=TwoWay}" Width="45" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding LatitudeMinutes, Mode=TwoWay}" Width="35" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding LatitudeSeconds, Mode=TwoWay}" Width="35" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllLatitudeHemispheres}"
                                  SelectedItem="{Binding LatHemi, Mode=TwoWay}" Width="70"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Lon" VerticalAlignment="Center" Width="30"/>
                        <TextBox Text="{Binding LongitudeDegrees, Mode=TwoWay}" Width="45" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding LongitudeMinutes, Mode=TwoWay}" Width="35" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding LongitudeSeconds, Mode=TwoWay}" Width="35" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllLongitudeHemispheres}"
                                  SelectedItem="{Binding LonHemi, Mode=TwoWay}" Width="70"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LabelCoordinates}" FontSize="11" Foreground="Gray" Margin="0,4,0,2"
                               Visibility="{Binding HasCoordinates, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding CoordinatesText}" FontFamily="Courier New"
                               Visibility="{Binding HasCoordinates, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Calculate button -->
            <Button Content="{Binding LabelCalculate}" Command="{Binding CalculateCommand}"
                    HorizontalAlignment="Left" Padding="12,4"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
