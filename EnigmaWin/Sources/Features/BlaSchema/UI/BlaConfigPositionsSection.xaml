<UserControl x:Class="EnigmaWin.Sources.Features.BlaSchema.UI.BlaConfigPositionsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Options -->
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelHouseSystem}" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                  ItemsSource="{Binding HouseSystemNames}"
                                  SelectedIndex="{Binding HouseSystemIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelCorrectionType}" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                  ItemsSource="{Binding CorrectionTypeNames}"
                                  SelectedIndex="{Binding CorrectionTypeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                    <CheckBox Content="{Binding LabelUseTrueNode}"  IsChecked="{Binding UseTrueNode}"  Margin="0,4"/>
                    <CheckBox Content="{Binding LabelUseChiron}"    IsChecked="{Binding UseChiron}"    Margin="0,4"/>
                    <CheckBox Content="{Binding LabelUseCeres}"     IsChecked="{Binding UseCeres}"     Margin="0,4"/>
                    <CheckBox Content="{Binding LabelUseDecanates}" IsChecked="{Binding UseDecanates}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <!-- Positions -->
            <TextBlock Text="{Binding LabelPositionsTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=""/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelColFactor}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelColPosition}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text=""/>
                        <TextBlock Grid.Column="4" Text="{Binding LabelColHouse}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding LabelColDecanate}" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>
                    <Separator Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Positions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FactorGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FactorName}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PositionText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding House}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Decanate}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- House positions -->
            <TextBlock Text="{Binding LabelHousePositionsTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelColCusp}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelColPosition}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text=""/>
                        <TextBlock Grid.Column="3" Text="{Binding LabelColDecanate}" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>
                    <Separator Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding HousePositions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Decanate}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
