<UserControl x:Class="EnigmaWin.Sources.Features.BlaSchema.UI.BlaDetailsCyclesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Details -->
            <TextBlock Text="{Binding LabelDetailsTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource GlyphFont}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Cycles -->
            <TextBlock Text="{Binding LabelCyclesTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Cycles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ElemCross}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Shortened cycles -->
            <TextBlock Text="{Binding LabelShortenedCyclesTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10">
                <ItemsControl ItemsSource="{Binding ShortenedCycles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ElemCross}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
