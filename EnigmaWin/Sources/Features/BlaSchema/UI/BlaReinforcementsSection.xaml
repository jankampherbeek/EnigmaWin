<UserControl x:Class="EnigmaWin.Sources.Features.BlaSchema.UI.BlaReinforcementsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ReinforcementRowTemplate">
            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FactorGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="{Binding Description}"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionText}" FontFamily="{StaticResource GlyphFont}" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="{Binding LabelInOwnSignTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding FactorsInOwnSigns}" ItemTemplate="{StaticResource ReinforcementRowTemplate}"/>
            </Border>

            <TextBlock Text="{Binding LabelInOwnHouseTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding FactorsInOwnHouses}" ItemTemplate="{StaticResource ReinforcementRowTemplate}"/>
            </Border>

            <TextBlock Text="{Binding LabelInOwnMundaneHouseTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding FactorsInOwnMundaneHouses}" ItemTemplate="{StaticResource ReinforcementRowTemplate}"/>
            </Border>

            <TextBlock Text="{Binding LabelLordInAnalogSignTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding HouseLordsInAnalogSigns}" ItemTemplate="{StaticResource ReinforcementRowTemplate}"/>
            </Border>

            <TextBlock Text="{Binding LabelPairsAnalogTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10">
                <ItemsControl ItemsSource="{Binding PairsAnalogHouseSign}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Factor1Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                                    <TextBlock Text=" + " />
                                    <TextBlock Text="{Binding Factor2Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                                    <TextBlock Text=" = " />
                                    <TextBlock Text="{Binding House}"/>
                                    <TextBlock Text=" + " />
                                    <TextBlock Text="{Binding SignGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
