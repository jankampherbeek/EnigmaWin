<UserControl x:Class="EnigmaWin.Sources.Features.BlaSchema.UI.BlaDispositorsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding LabelDispositorsTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelColRulers}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelColCombined}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelColMain}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding LabelColIndirect}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding LabelColSum}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding LabelColHouse}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="{Binding LabelColIndirect}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="{Binding LabelColSum}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="{Binding LabelColDecanateShort}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="9" Text="{Binding LabelColTotal}" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>
                    <Separator Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Dispositors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding MainRulerGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16"/>
                                            <TextBlock Text="{Binding SubRulerGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="16" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SignSplit}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SignMain}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SignIndirect}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SignSum}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{Binding HouseMain}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="{Binding HouseIndirect}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="7" Text="{Binding HouseSum}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="8" Text="{Binding DecanateDirect}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="9" Text="{Binding Total}" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Grid Name="DispositorsPiePanel" Height="220" Margin="0,12,0,0" Background="White"/>
            <WrapPanel Name="DispositorsLegendPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
