<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:EnigmaWin.Sources.AppShell.UI"
        x:Class="EnigmaWin.Sources.AppShell.UI.AboutWindow"
        x:DataType="ui:AboutWindow"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="16" Margin="24">

        <TextBlock Text="{Binding LabelTitle}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <TextBlock Text="{Binding LabelIntro}"    TextWrapping="Wrap"/>
        <TextBlock Text="{Binding LabelFree}"     TextWrapping="Wrap"/>
        <TextBlock Text="{Binding LabelThanks}"   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding LabelNames}"    TextWrapping="Wrap" FontStyle="Italic"/>

        <Button Content="{Binding LabelClose}"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Click="OnCloseClicked"/>

    </StackPanel>
</Window>
