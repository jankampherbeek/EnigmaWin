<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnigmaWin.ViewModels.Routes"
             x:Class="EnigmaWin.Sources.AppShell.UI.ResearchWorkspaceScreen"
             x:DataType="vm:ResearchWorkspaceRouteViewModel"
             d:DesignWidth="700"
             d:DesignHeight="500"
             mc:Ignorable="d">
    <StackPanel Spacing="10" Margin="8">
        <TextBlock Text="Research Workspace" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Werk met datafiles en projecten voor onderzoek." Opacity="0.75"/>
    </StackPanel>
</UserControl>
