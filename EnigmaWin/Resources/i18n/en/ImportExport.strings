// ImportExport.strings - English

"view.importexport.title"  = "Import / Export";
"view.importexport.select" = "Select a format in the left menu bar to import or export charts and events.";

"view.importexport.export.button"   = "Export…";
"view.importexport.import.button"   = "Import…";
"view.importexport.record.message"  = "Record {0}: {1}";
"view.importexport.error.readfile"  = "The file could not be read: {0}";
"view.importexport.error.writefile" = "The file could not be written: {0}";
"view.importexport.error.database"  = "The database could not be accessed: {0}";
"view.importexport.filter.allfiles" = "All files";

"view.importexport.enigma.title"          = "Enigma";
"view.importexport.enigma.body"           = "Export all charts and events to a JSON file, or import charts and events from a previously exported file. Calculated positions are not included; they are recalculated from the imported data. Files can be exchanged with the Apple version of Enigma.";
"view.importexport.enigma.filter"         = "Enigma export file";
"view.importexport.enigma.export.success" = "Exported {0} charts and {1} events.";
"view.importexport.enigma.import.success" = "Imported {0} charts and {1} events (skipped {2} charts and {3} events already present).";

"view.importexport.qck.title"          = "QuickChart";
"view.importexport.qck.body"           = "Export all charts to a Quick*Chart (.qck) file, or import charts from one. QCK is a legacy fixed-width format: long names and places are truncated and the original timezone is not preserved, though the moment in time always is.";
"view.importexport.qck.filter"         = "QuickChart file";
"view.importexport.qck.export.success" = "Exported {0} charts.";
"view.importexport.qck.import.success" = "Imported {0} charts.";

"view.importexport.aaf.title"          = "AAF'97";
"view.importexport.aaf.body"           = "Export all charts to an AAF'97 (Astrological Exchange Format) file, or import charts from one. AAF's event/country/organisation record types are kept as a chart category, since Enigma events must be linked to an existing chart. Positions, houses and aspects are not read or written; Enigma recalculates them from the imported date, time and place.";
"view.importexport.aaf.filter"         = "AAF file";
"view.importexport.aaf.export.success" = "Exported {0} charts.";
"view.importexport.aaf.import.success" = "Imported {0} charts (skipped {1} already present).";

