// Help texts
"view.chartwheel.help.zodiac"  = "The horoscope chart with equal signs and variable house size.\nThe 'Black/white' button gives you a version without colour.\nIf you don't want to see aspects, use the 'No aspects' button.\nThe 'No time' button removes cusps, MC and Ascendant and places 0 degrees Aries where the Ascendant normally is.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.house"   = "The horoscope chart with equal houses and variable sign size.\nThe 'Black/white' button gives you a version without colour.\nThe 'No time' button removes cusps, MC and Ascendant and places 0 degrees Aries where the Ascendant normally is.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.french"  = "The horoscope chart as commonly used in France.\nThe 'Black/white' button gives you a version without colour.\nIf you don't want to see aspects, use the 'No aspects' button.\nThe 'No time' button removes cusps, MC and Ascendant and places 0 degrees Aries where the Ascendant normally is.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.ring"    = "The horoscope chart in the style of the German astrologer/artist Thomas Ring.\nThe 'Black/white' button gives you a version without colour.\nIf you don't want to see aspects, use the 'No aspects' button.\nThe 'No time' button removes cusps, MC and Ascendant and places 0 degrees Aries where the Ascendant normally is.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.dial360" = "This is a 360-degree dial for midpoints.\nIn this dial the factors are at their usual position.\nYou can switch the dial to a 90-degree or 45-degree dial using the buttons at the bottom.\nThe 'Black/white' button gives you a version without colour.\nThe 'No time' button removes the MC and Ascendant.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.dial90"  = "This is a 90-degree dial for midpoints.\nFor each factor you see the converted position in 90 degrees plus the original sign the factor is in.\nYou can switch the dial to a 360-degree or 45-degree dial using the buttons at the bottom.\nThe 'Black/white' button gives you a version without colour.\nThe 'No time' button removes the MC and Ascendant.\nWith the 'Export' button you can save the image as PDF or PNG.";
"view.chartwheel.help.dial45"  = "This is a 45-degree dial for midpoints.\nFor each factor you see the converted position in 45 degrees plus the original sign the factor is in.\nYou can switch the dial to a 360-degree or 90-degree dial using the buttons at the bottom.\nThe 'Black/white' button gives you a version without colour.\nThe 'No time' button removes the MC and Ascendant.\nWith the 'Export' button you can save the image as PDF or PNG.";

