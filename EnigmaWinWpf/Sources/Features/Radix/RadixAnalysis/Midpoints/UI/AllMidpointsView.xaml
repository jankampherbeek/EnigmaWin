<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Midpoints.UI.AllMidpointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="600">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar with factsheet + help buttons -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding LabelTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="{Binding TooltipFactsheet}"
                            Margin="0,0,4,0"
                            Click="OnFactsheetClicked">
                        <Image Source="/Resources/Assets/factsheet.png" Width="16" Height="16"/>
                    </Button>
                    <Button Content="?"
                            ToolTip="{Binding TooltipHelp}"
                            Click="OnHelpClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock Text="{Binding LabelEmpty}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6"/>

            <!-- Two-column data layout -->
            <ScrollViewer Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelFactor1}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelFactor2}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelPosition}" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LeftRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="4,1,8,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph1}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="14"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph2}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="14"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding PositionDms}" FontSize="13"/>
                                                <TextBlock Text="{Binding SignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="14"
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Right column -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="8,0,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelFactor1}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding LabelFactor2}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{Binding LabelPosition}" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RightRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                        <Grid Margin="8,1,4,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph1}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="14"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph2}"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="14"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding PositionDms}" FontSize="13"/>
                                                <TextBlock Text="{Binding SignGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="14"
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
