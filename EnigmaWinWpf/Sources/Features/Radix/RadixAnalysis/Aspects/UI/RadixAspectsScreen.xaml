<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixAnalysis.Aspects.UI.RadixAspectsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Radix.RadixAnalysis.Aspects.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="700">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title row with help button -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding LabelTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Content="?"
                    ToolTip="{Binding TooltipHelp}"
                    Click="OnHelpClicked"/>
        </Grid>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   Text="{Binding LabelEmpty}"
                   Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Content when data is available -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!-- Aspect grid section -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding LabelGridTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ui:AspectGridControl x:Name="AspectGrid"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- Aspect list section -->
                <StackPanel>
                    <TextBlock Text="{Binding LabelListTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <Border BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text=""                         FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LabelFactor1}"   FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text=""                         FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding LabelAspect}"    FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="{Binding LabelFactor2}"   FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5" Text="{Binding LabelOrb}"       FontWeight="SemiBold" TextAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="{Binding LabelExactness}" FontWeight="SemiBold" TextAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,0,0,2"/>

                            <!-- Aspect rows -->
                            <ItemsControl ItemsSource="{Binding AspectRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsEvenRow, Converter={StaticResource BoolToRowBgConverter}}">
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Factor1Glyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="18"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Factor1Name}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AspectGlyph}"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding AspectName}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Factor2Name}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding OrbText}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding ExactnessText}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
