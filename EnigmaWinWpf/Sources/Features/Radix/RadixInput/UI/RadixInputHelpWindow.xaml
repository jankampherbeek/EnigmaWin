<Window x:Class="EnigmaWin.Sources.Features.Radix.RadixInput.UI.RadixInputHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding HeaderAbout}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding AboutLine1}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding AboutLine2}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding HeaderLocation}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding LocationLine1}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding LocationLine2}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding HeaderDateTime}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding DateTimeLine1}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding DateTimeLine2}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding DateTimeLine3}" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="{Binding LabelClose}"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Click="OnCloseClicked"/>

    </StackPanel>
</Window>
