<UserControl x:Class="EnigmaWin.Sources.Features.Radix.RadixInput.UI.DateTimeSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="108"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Date row -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelDate}" VerticalAlignment="Center" Margin="0,4,4,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Year, Mode=TwoWay}" Margin="0,4,4,4"/>
                <ComboBox Grid.Row="0" Grid.Column="2" Margin="0,4,4,4"
                          ItemsSource="{Binding MonthValues}" SelectedItem="{Binding Month, Mode=TwoWay}"/>
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,4,4,4"
                          ItemsSource="{Binding DayValues}" SelectedItem="{Binding Day, Mode=TwoWay}"/>

                <!-- Calendar/YearCount row -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelCalendarYearCount}" VerticalAlignment="Center" Margin="0,4,4,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,4,4"
                          ItemsSource="{Binding CalendarValues}" SelectedItem="{Binding Calendar, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Year count" VerticalAlignment="Center" Margin="0,4,4,4"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,4,4,4"
                          ItemsSource="{Binding YearCountValues}" SelectedItem="{Binding YearCount, Mode=TwoWay}"/>

                <!-- Time/DST row -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelTimeDst}" VerticalAlignment="Center" Margin="0,4,4,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="70" Margin="0,4,4,4"
                          ItemsSource="{Binding HourValues}" SelectedItem="{Binding Hour, Mode=TwoWay}"/>
                <ComboBox Grid.Row="2" Grid.Column="2" Width="70" Margin="0,4,4,4"
                          ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding Minute, Mode=TwoWay}"/>
                <ComboBox Grid.Row="2" Grid.Column="3" Width="70" Margin="0,4,4,4"
                          ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding Second, Mode=TwoWay}"/>
                <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,4,4,4"
                          ItemsSource="{Binding DstValues}" SelectedItem="{Binding Dst, Mode=TwoWay}"/>

                <!-- Offset UT row -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LabelOffsetUt}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Width="70" Margin="0,4,4,0"
                          ItemsSource="{Binding HourValues}" SelectedItem="{Binding OffsetHour, Mode=TwoWay}"/>
                <ComboBox Grid.Row="3" Grid.Column="2" Width="70" Margin="0,4,4,0"
                          ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding OffsetMinute, Mode=TwoWay}"/>
                <ComboBox Grid.Row="3" Grid.Column="3" Width="70" Margin="0,4,4,0"
                          ItemsSource="{Binding MinuteSecondValues}" SelectedItem="{Binding OffsetSecond, Mode=TwoWay}"/>
                <ComboBox Grid.Row="3" Grid.Column="4" Margin="0,4,0,0"
                          ItemsSource="{Binding OffsetDirectionValues}" SelectedItem="{Binding OffsetDirection, Mode=TwoWay}"/>
            </Grid>

            <TextBlock Text="{Binding DateTimeSectionError}"
                       Foreground="IndianRed"
                       Visibility="{Binding HasDateTimeSectionError, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
