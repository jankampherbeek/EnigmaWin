<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigSectionPlaceholderScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">
        <StackPanel Margin="0,0,0,12">
            <Button Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>
        <Border BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding Config.Name}" FontSize="14" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                <TextBlock Text="This section editor will be implemented in the next step."
                           Opacity="0.6" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
