<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigHomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">
        <TextBlock Text="Configuration" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Border BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding ConfigName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Border CornerRadius="4" Padding="6,2"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                            Background="#007AFF">
                        <TextBlock Text="Active" Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Opacity="0.85" Margin="0,0,0,4"/>
                <TextBlock Text="Section editors will be added in the next step." Opacity="0.6" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
