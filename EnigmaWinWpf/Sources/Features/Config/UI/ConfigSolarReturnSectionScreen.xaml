<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigSolarReturnSectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">

        <!-- Header -->
        <StackPanel Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="{Binding LabelCancel}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnCancelClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Content="{Binding LabelSave}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                        Click="OnSaveClicked" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Content="?" ToolTip="{Binding LabelHelpTooltip}" Click="OnHelpClicked"/>
            </Grid>
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Settings -->
        <Border BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding LabelSectionSettings}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelMethod}" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                              ItemsSource="{Binding MethodNames}"
                              SelectedIndex="{Binding SelectedMethodIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelLocation}" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                              ItemsSource="{Binding LocationNames}"
                              SelectedIndex="{Binding SelectedLocationIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelOrb}" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <TextBox Text="{Binding OrbDeg, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                        <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding OrbMin, Mode=TwoWay}" Width="60" Margin="0,0,4,0"/>
                        <TextBlock Text="'" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
