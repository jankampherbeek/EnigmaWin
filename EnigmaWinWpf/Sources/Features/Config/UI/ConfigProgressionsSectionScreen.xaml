<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigProgressionsSectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">
        <StackPanel Margin="0,0,0,12">
            <Button Content="{Binding LabelBackToOverview}" Click="OnBackClicked" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel MaxWidth="320" HorizontalAlignment="Left">
            <Button Content="{Binding LabelPrimary}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Margin="0,0,0,8" Click="OnPrimaryClicked"/>
            <Button Content="{Binding LabelTransits}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Margin="0,0,0,8" Click="OnTransitsClicked"/>
            <Button Content="{Binding LabelSecondary}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Margin="0,0,0,8" Click="OnSecondaryClicked"/>
            <Button Content="{Binding LabelSymbolic}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Margin="0,0,0,8" Click="OnSymbolicClicked"/>
            <Button Content="{Binding LabelSolar}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="OnSolarClicked"/>
        </StackPanel>
    </StackPanel>
</UserControl>
