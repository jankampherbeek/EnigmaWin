<UserControl x:Class="EnigmaWin.Sources.Features.Config.UI.ConfigListScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:EnigmaWin.Sources.Features.Config"
             Width="300">

    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + Add button -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Button Content="{Binding LabelAdd}" HorizontalAlignment="Right" Click="OnAddClicked" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding LabelTitle}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Config list -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Configurations}"
                     SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type cfg:UserConfiguration}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                <TextBlock FontSize="11" Opacity="0.65"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="● Active"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="✓" FontSize="16"
                                       VerticalAlignment="Center" Margin="6,0"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>

                            <Button Grid.Column="2" Content="✕" FontSize="12" Padding="6,2"
                                    VerticalAlignment="Center" Click="OnDeleteClicked"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state (shown when Configurations.Count == 0) -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Configurations.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding LabelEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LabelEmptyDesc}" TextWrapping="Wrap" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Add config overlay panel -->
        <Border Visibility="{Binding IsAddPanelVisible, Converter={StaticResource BoolToVisibility}}"
                Background="White" BorderThickness="1" CornerRadius="8"
                Padding="16" Margin="8" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding LabelNewTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding LabelNewName}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewNameBox" Text="{Binding NewConfigName, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding LabelNewBasedOn}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Configurations}"
                              SelectedItem="{Binding BasedOnConfig, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type cfg:UserConfiguration}">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LabelNewBasedOnFooter}" TextWrapping="Wrap"
                               Opacity="0.7" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding LabelCancel}" Click="OnCancelAddClicked" Margin="0,0,8,0"/>
                    <Button Content="{Binding LabelNewCreate}" Click="OnConfirmAddClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
