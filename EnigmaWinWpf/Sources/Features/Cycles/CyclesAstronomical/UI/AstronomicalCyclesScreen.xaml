<UserControl x:Class="EnigmaWin.Sources.Features.Cycles.CyclesAstronomical.UI.AstronomicalCyclesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EnigmaWin.Sources.Features.Cycles.CyclesAstronomical.UI">

    <ScrollViewer>
        <StackPanel Margin="16">

            <!-- Title -->
            <TextBlock Text="{Binding LabelTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <!-- Start date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelStartDate}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding StartYearText, Mode=TwoWay}" Width="80" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding StartMonth, Mode=TwoWay}" Width="78" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding StartDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding StartCalendar, Mode=TwoWay}"
                                  Width="110" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding StartYearCount, Mode=TwoWay}"
                                  Width="130"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StartDateError}" Foreground="Red" FontSize="12"
                               Visibility="{Binding HasStartDateError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- End date -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding LabelEndDate}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LabelYear}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding EndYearText, Mode=TwoWay}" Width="80" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelMonth}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding MonthValues}"
                                  SelectedItem="{Binding EndMonth, Mode=TwoWay}" Width="78" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LabelDay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding DayValues}"
                                  SelectedItem="{Binding EndDay, Mode=TwoWay}" Width="78"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding AllCalendarStyles}"
                                  SelectedItem="{Binding EndCalendar, Mode=TwoWay}"
                                  Width="110" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllYearCounts}"
                                  SelectedItem="{Binding EndYearCount, Mode=TwoWay}"
                                  Width="130"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EndDateError}" Foreground="Red" FontSize="12"
                               Visibility="{Binding HasEndDateError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DateOrderError}" Foreground="Red" FontSize="12"
                       Visibility="{Binding HasDateOrderError, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,0,0,8"/>

            <!-- Observer position -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding LabelObserverPos}" VerticalAlignment="Center" Width="160" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AllObserverPositions}"
                          SelectedItem="{Binding ObserverPosition, Mode=TwoWay}"
                          Width="180"/>
            </StackPanel>

            <!-- Coordinate -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding LabelCoordinate}" VerticalAlignment="Center" Width="160" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AvailableCoordinates}"
                          SelectedItem="{Binding SelectedCoordinate, Mode=TwoWay}"
                          Width="180"/>
            </StackPanel>

            <!-- Ayanamsha -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding LabelAyanamsha}" VerticalAlignment="Center" Width="160" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AllAyanamshas}"
                          SelectedItem="{Binding Ayanamsha, Mode=TwoWay}"
                          Width="280"/>
            </StackPanel>

            <!-- Mode toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="{Binding LabelSingleFactors}"
                             IsChecked="{Binding IsSingleMode, Mode=TwoWay}" GroupName="FactorMode" Margin="0,0,16,0"/>
                <RadioButton Content="{Binding LabelPairsOfFactors}"
                             IsChecked="{Binding IsPairsMode, Mode=TwoWay}" GroupName="FactorMode"/>
            </StackPanel>

            <!-- Single factor selector -->
            <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding SelectedCountLabel}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ScrollViewer Height="260" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FactorItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:FactorItem}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Pairs selector -->
            <StackPanel Visibility="{Binding IsPairsMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <StackPanel Width="220" Margin="0,0,16,0">
                        <TextBlock Text="{Binding LabelFactorA}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AllFactorChoices}"
                                  SelectedItem="{Binding PendingChoiceA, Mode=TwoWay}"
                                  Width="220" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                    <StackPanel Width="220">
                        <TextBlock Text="{Binding LabelFactorB}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AllFactorChoices}"
                                  SelectedItem="{Binding PendingChoiceB, Mode=TwoWay}"
                                  Width="220" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="{Binding LabelAddPair}" Command="{Binding AddPairCommand}" Margin="0,0,0,6"/>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FactorPairs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding LabelAddedPairs}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding FactorPairs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:FactorPairItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="✕" Command="{Binding RemoveCommand}"
                                            Padding="4,2" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Calculate button and warning -->
            <Button Content="{Binding LabelCalculate}" Command="{Binding CalculateCommand}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding PeriodWarning}" Foreground="Orange" FontSize="12"
                       Visibility="{Binding HasPeriodWarning, Converter={StaticResource BoolToVisibility}}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
