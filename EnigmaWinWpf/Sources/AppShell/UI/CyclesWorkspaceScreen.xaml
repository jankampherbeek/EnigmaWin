<UserControl x:Class="EnigmaWin.Sources.AppShell.UI.CyclesWorkspaceScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="{Binding Title}"       FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Description}" Opacity="0.75"/>
    </StackPanel>
</UserControl>
